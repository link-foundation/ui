[2026-11-03T20:40:18.454Z] [STDOUT] {"type":"item.completed","item":{"id":"item_125","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,100p' packages/ui-devmode/tests/index.test.js; sed -n '1,130p' packages/ui-devmode/tests/setup.js; sed -n '1,130p' packages/ui-devmode/src/model.js\"","aggregated_output":"/**\n * `mountDevMode` over the sample page in jsdom: open and close, the\n * global handle, the outline, pick mode, live edits, Save, Discard and\n * Reset, and a disabled policy that never loads the inspector.\n */\n\nimport { describe, it, expect } from 'test-anywhere';\nimport { GLOBAL_NAME, mountDevMode } from '../src/index.js';\nimport {\n  createPage,\n  key,\n  POLICY,\n  sample,\n  shortcut,\n  tick,\n  waitFor,\n} from './setup.js';\n\n/** The sample page with dev mode mounted (and opened unless `open: false`). */\nasync function openPage({ policy = POLICY, open = true, url } = {}) {\n  const page = createPage({ url });\n  const dev = mountDevMode({\n    root: page.root,\n    config: page.config,\n    store: page.store,\n    handle: page.handle,\n    window: page.window,\n    styles: sample('styles'),\n    tokens: [REDACTED]'tokens'),\n    animations: sample('animation'),\n    policy,\n  });\n  if (open) {\n    expect(await dev.open()).toBe(true);\n  }\n  const shadow = () =>\n    page.document.querySelector('ui-devmode-inspector')?.shadowRoot ?? null;\n  const $ = (selector) => shadow().querySelector(selector);\n  const row = (name) => $(`tr[data-name=\"${name}\"]`);\n  const okButton = () => page.handle.nodeFor('ok').querySelector('button');\n  return { ...page, dev, shadow, $, row, okButton };\n}\n\nconst click = (window, node) =>\n  node.dispatchEvent(\n    new window.MouseEvent('click', {\n      bubbles: true,\n      cancelable: true,\n      composed: true,\n    })\n  );\n\ndescribe('mountDevMode', () => {\n  it('opens the inspector and publishes the global handle', async () => {\n    const { dev, $, document } = await openPage();\n    expect(dev.isOpen).toBe(true);\n    const handle = globalThis[GLOBAL_NAME];\n    expect(Object.keys(handle)).toEqual([\n      'select',\n      'getSelection',\n      'setProperty',\n      'close',\n    ]);\n    expect($('[role=\"complementary\"]')).not.toBe(null);\n    // Each view renders into its tabpanel; the tab buttons hold text only.\n    expect($('[role=\"tab\"] *')).toBe(null);\n    expect($('[role=\"tabpanel\"][data-view=\"outline\"] [role=\"tree\"]')).not.toBe(\n      null\n    );\n    expect(document.querySelector('ui-devmode-overlay')).not.toBe(null);\n    expect($('[data-command=\"pick\"]').getAttribute('aria-pressed')).toBe(\n      'true'\n    );\n    handle.close();\n    expect(dev.isOpen).toBe(false);\n    expect(globalThis[GLOBAL_NAME]).toBe(undefined);\n    expect(document.querySelector('ui-devmode-inspector')).toBe(null);\n    expect(document.querySelector('ui-devmode-overlay')).toBe(null);\n    dev.destroy();\n  });\n\n  it('shows the outline app > body > greeting, ok, synced with the selection', async () => {\n    const { dev, $, shadow } = await openPage();\n    const items = () => [...shadow().querySelectorAll('[role=\"treeitem\"]')];\n    expect(\n      items().map((n) => `${n.getAttribute('aria-level')}:${n.dataset.id}`)\n    ).toEqual(['1:app', '2:body', '3:greeting', '3:ok']);\n    $('[data-id=\"ok\"] .row').click();\n    expect(globalThis[GLOBAL_NAME].getSelection()).toEqual({\n      id: 'ok',\n      type: 'button',\n    });\n    expect($('[data-id=\"ok\"]').getAttribute('aria-selected')).toBe('true');\n    globalThis[GLOBAL_NAME].select('greeting');\n    expect($('[data-id=\"greeting\"]').getAttribute('aria-selected')).toBe(\n      'true'\n    );\n    expect($('[data-id=\"ok\"]').getAttribute('aria-selected')).toBe('false');\n    dev.destroy();\n  });\n/**\n * Shared helpers of the ui-devmode tests: the issue-1 samples, the policy of\n * the issue, and a fresh jsdom window with the sample page mounted by ui-dom\n * and bound to a ui-config configuration.\n */\n\nimport { readFileSync } from 'node:fs';\nimport { URL } from 'node:url';\nimport { JSDOM } from 'jsdom';\nimport { parse } from '@link-foundation/ui-core';\nimport { createConfig } from '@link-foundation/ui-config';\nimport { mountDocument } from '@link-foundation/ui-dom';\n\nconst SAMPLES = new URL(\n  '../../../docs/case-studies/issue-1/samples/',\n  import.meta.url\n);\n\n/** A sample of docs/case-studies/issue-1/samples/ (`document`, `styles`…). */\nexport const sample = (name) =>\n  readFileSync(new URL(`${name}.lino`, SAMPLES), 'utf8');\n\n/** The site policy of the issue. */\nexport const POLICY = `(site-dev-mode: dev-mode\n  (enabled true)\n  (entry shortcut url-parameter element)\n  (shortcut 'Alt+Shift+D')\n  (write-layers session user)\n  (locked-elements payment-form))`;\n\n/** A fresh window (`url` sets `location`) with `<div id=\"app\">`. */\nexport function createDom({ url = 'http://localhost/', body = '' } = {}) {\n  const dom = new JSDOM(\n    `<!doctype html><html><head></head><body><div id=\"app\"></div>${body}</body></html>`,\n    { url, pretendToBeVisual: true }\n  );\n  const { window } = dom;\n  return {\n    window,\n    document: window.document,\n    root: window.document.getElementById('app'),\n  };\n}\n\n/**\n * The sample page: `document.lino` rendered by ui-dom into `#app`, its\n * configuration (`document.lino` as the site layer) bound to the store, and\n * the `on press` actions the app received.\n */\nexport function createPage(options = {}) {\n  const dom = createDom(options);\n  const text = sample('document');\n  const actions = [];\n  const { store, handle } = mountDocument(dom.root, text, {\n    styles: sample('styles'),\n    tokens: [REDACTED]'tokens'),\n    setTitle: false,\n    onAction: (detail) => actions.push(detail),\n  });\n  const config = createConfig({ document: parse(text) });\n  config.bindStore(store);\n  return { ...dom, text, store, handle, config, actions };\n}\n\n/** Wait for queued ta