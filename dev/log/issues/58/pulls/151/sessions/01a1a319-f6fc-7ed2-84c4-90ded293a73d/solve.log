ulary?: object,\n *   parentOf?: (id: string) => string|null,\n *   document?: object,\n *   getElement?: (id: string) => object|undefined }} options  the element\n *   is looked up with `getElement` or in `document` (a ui-store store or a\n *   ui-core document)\n * @returns {{ id: string, name: string, key: string|null, layer: string,\n *   values: readonly unknown[] }}\n * @throws {DevModeError}\n */\nexport function applyEdit(config, edit, options) {\n  const { policy } = options;\n  const layer = writableLayer(policy, edit.layer);\n  const { id, name } = edit;\n  const element = elementOf(options, id);\n  if (isLocked(policy, id, options.parentOf)) {\n    fail('locked-element', `\"${id}\" is locked by the site policy`);\n  }\n  const vocabulary = options.vocabulary ?? defaultVocabulary();\n  const values = editValues(edit.value);\n  checkValues(typeOf(vocabulary, element, name), values, name === element.kind);\n  const key = edit.key ?? null;\n  config.set(layer, id, name, values, key ?? undefined);\n  return Object.freeze({ id, name, key, layer, values });\n}\n\n/**\n * Reset a property: remove it from the highest writable layer that holds\n * it, so the value of the layer below shows again. The element is locked\n * when it or an ancestor (`parentOf`) is in `(locked-elements …)`.\n * @param {object} config  a ui-config configuration\n * @param {{ id: string, name: string, key?: string|null }} target\n * @param {{ policy: import('./policy.js').DevModePolicy,\n *   parentOf?: (id: string) => string|null }} options\n * @returns {string|null}  the layer the value was removed from\n */\nexport function resetProperty(\n  config,\n  { id, name, key = null },\n  { policy, parentOf }\n) {\n  if (isLocked(policy, id, parentOf)) {\n    fail('locked-element', `\"${id}\" is locked by the site policy`);\n  }\n  for (const layer of [...policy.writeLayers].reverse()) {\n    if (config.valueIn(layer, id, name, key ?? undefined) !== undefined) {\n      config.unset(layer, id, name, key ?? undefined);\n      return layer;\n    }\n  }\n  return null;\n}\n\n/**\n * Save: move every session override to the user layer (which ui-config\n * persists), then clear the session.\n * @returns {number}  the number of overrides moved\n */\nexport function saveSession(config, { policy }) {\n  if (!policy.writeLayers.includes('user')) {\n    fail('read-only-layer', 'The site policy does not allow saving');\n  }\n  const moved = config.overrides('session');\n  for (const o of moved) {\n    config.set('user', o.id, o.name, o.values, o.key ?? undefined);\n  }\n  config.clear('session');\n  return moved.length;\n}\n\n/** Discard: clear the session layer. */\nexport function discardSession(config) {\n  const count = config.overrides('session').length;\n  config.clear('session');\n  return count;\n}\n/**\n * The inspector panel: a host docked to the right of the page, resizable,\n * whose shadow root holds the layout of `inspector.lino` rendered by ui-dom\n * with the dev mode kinds below. Every text comes from the message table.\n *\n * The panel knows nothing of the page: `session.js` fills its views and\n * reacts to its commands.\n */\n\nimport { mountDocument } from '@link-foundation/ui-dom';\nimport { INSPECTOR_CSS } from './inspector-css.js';\n\n/** The width of the panel, in CSS pixels. */\nexport const WIDTH = Object.freeze({ initial: 420, min: 280, step: 16 });\n\nconst kind = (properties, children = 'any') => ({\n  positional: [],\n  properties: new Map(\n    properties.map((name) => [name, { type: 'string', multi: false }])\n  ),\n  children,\n});\n\n/**\n * The vocabulary of `inspector.lino`: the dev mode kinds and their\n * properties (all text, message keys or names).\n */\nexport const LAYOUT_VOCABULARY = Object.freeze({\n  version: null,\n  kinds: new Map([\n    ['devmode-panel', kind(['label'])],\n    ['devmode-heading', kind(['label'], 'none')],\n    ['devmode-toolbar', kind(['label'])],\n    ['devmode-action', kind(['label', 'command', 'toggle'], 'none')],\n    ['devmode-status', kind(['label', 'role'], 'none')],\n    ['devmode-tabs', kind(['label'])],\n    ['devmode-tab', kind(['label', 'view'], 'none')],\n  ]),\n  actions: new Map(),\n  multiValued: new Set(),\n});\n\nconst text = (el, name) => {\n  const value = el.props.get(name)?.[0];\n  return typeof value === 'string' ? value : undefined;\n};\n\n/** The translated `label` of a layout element. */\nconst label = (el, ctx) => ctx.options.t(text(el, 'label') ?? '');\n\nconst make = (ctx, tag, attributes = {}) => {\n  const node = ctx.document.createElement(tag);\n  for (const [name, value] of Object.entries(attributes)) {\n    node.setAttribute(name, value);\n  }\n  return node;\n};\n\n/** The ui-dom kinds of the layout (render option `kinds`). */\nexport const LAYOUT_KINDS = Object.freeze({\n  'devmode-panel': {\n    tag: 'ui-devmode-panel',\n    create: (el, ctx) =>\n      make(ctx, 'ui-devmode-panel', {\n        role: 'complementary',\n        'aria-label': label(el, ctx),\n      }),\n  },\n  'devmode-heading': {\n    tag: 'ui-devmode-heading',\n    childrenSlot: null,\n    create(el, ctx) {\n      const node = make(ctx, 'ui-devmode-heading', {\n        role: 'heading',\n        'aria-level': '2',\n      });\n      node.textContent = label(el, ctx);\n      return node;\n    },\n  },\n  'devmode-toolbar': {\n    tag: 'ui-devmode-toolbar',\n    create: (el, ctx) =>\n      make(ctx, 'ui-devmode-toolbar', {\n        role: 'group',\n        'aria-label': label(el, ctx),\n      }),\n  },\n  'devmode-action': {\n    tag: 'ui-devmode-action',\n    childrenSlot: null,\n    create(el, ctx) {\n      const node = make(ctx, 'ui-devmode-action');\n      const button = make(ctx, 'button', {\n        type: 'button',\n        'data-command': text(el, 'command') ?? '',\n      });\n      if (text(el, 'toggle') === 'true') {\n        button.setAttribute('aria-pressed', 'false');\n      }\n      button.textContent = label(el, ctx);\n      node.append(button);\n      return node;\n    },\n  },\n  'devmode-status': {\n    tag: 'ui-devmode-status',\n    childrenSlot: null,\n    create(el, ctx) {\n      const role = text(el, 'role');\n      const node = make(ctx, 'ui-devmode-status', { 'data-role': role ?? '' });\n      if (role === 'live') {\n        node.setAttribute('role', 'status');\n      }\n      node.textContent = text(el, 'label') ? label(el, ctx) : '';\n      return node;\n    },\n  },\n  'devmode-tabs': {\n    tag: 'ui-devmode-tabs',\n    create(el, ctx) {\n      const node = make(ctx, 'ui-devmode-tabs');\n      const list = make(ctx, 'div', {\n        role: 'tablist',\n        'aria-label': label(el, ctx),\n      });\n      const panels = make(ctx, 'div', { class: 'panels' });\n      node.append(list, panels);\n      return node;\n    },\n    childrenSlot: (node) => node.querySelector('.panels'),\n  },\n  'devmode-tab': {\n    tag: 'ui-devmode-tab',\n    childrenSlot: null,\n    create: (el, ctx) =>\n      make(ctx, 'ui-devmode-tab', {\n        role: 'tabpanel',\n        tabindex: '0',\n        'data-view': text(el, 'view') ?? '',\n        'data-label': label(el, ctx),\n      }),\n  },\n});\n\n/**\n * Read `inspector.lino` next to this module: with `fetch` in a browser,\n * from the file system in Node.js.\n * @returns {Promise<string>}\n */\nexport async function loadLayout() {\n  const url = new globalThis.URL('./inspector.lino', import.meta.url);\n  if (url.protocol === 'file:') {\n    const { readFile } = await import('node:fs/promises');\n    return readFile(url, 'utf8');\n  }\n  const response = await globalThis.fetch(url);\n  if (!response.ok) {\n    throw new Error(`Could not load ${url}: ${response.status}`);\n  }\n  return response.text();\n}\n\n/** Make the tab buttons of the panels and wire the WAI-ARIA tabs keys. */\nfunction buildTabs(shadow, onChange) {\n  const list = shadow.querySelector('[role=\"tablist\"]');\n  const panels = [...shadow.querySelectorAll('[role=\"tabpanel\"]')];\n  const doc = shadow.ownerDocument;\n  const tabs = panels.map((panel) => {\n    const view = panel.dataset.view;\n    const tab = doc.createElement('button');\n    tab.type = 'button';\n    tab.setAttribute('role', 'tab');\n    tab.id = `devmode-tab-${view}`;\n    tab.dataset.view = view;\n    tab.textContent = panel.dataset.label;\n    panel.id = `devmode-panel-${view}`;\n    tab.setAttribute('aria-controls', panel.id);\n    panel.setAttribute('aria-labelledby', tab.id);\n    list.append(tab);\n    return tab;\n  });\n  const select = (view, focus = false) => {\n    tabs.forEach((tab, i) => {\n      const on = tab.dataset.view === view;\n      tab.setAttribute('aria-selected', String(on));\n      tab.tabIndex = on ? 0 : -1;\n      panels[i].hidden = !on;\n      if (on && focus) {\n        tab.focus();\n      }\n    });\n    onChange(view);\n  };\n  list.addEventListener('click', (event) => {\n    const tab = event.target.closest?.('[role=\"tab\"]');\n    if (tab) {\n      select(tab.dataset.view);\n    }\n  });\n  list.addEventListener('keydown', (event) => {\n    const at = tabs.indexOf(event.target);\n    const moves = {\n      ArrowRight: at + 1,\n      ArrowLeft: at - 1,\n      Home: 0,\n      End: tabs.length - 1,\n    };\n    if (at < 0 || !(event.key in moves)) {\n      return;\n    }\n    event.preventDefault();\n    const next = (moves[event.key] + tabs.length) % tabs.length;\n    select(tabs[next].dataset.view, true);\n  });\n  return { select, panels };\n}\n\n/** The WAI-ARIA window splitter on the left edge of the panel. */\nfunction buildSplitter(host, shadow, t, window) {\n  const doc = shadow.ownerDocument;\n  const splitter = doc.createElement('div');\n  splitter.className = 'splitter';\n  splitter.tabIndex = 0;\n  splitter.setAttribute('role', 'separator');\n  splitter.setAttribute('aria-orientation', 'vertical');\n  splitter.setAttribute('aria-label', t('resize.label'));\n  splitter.setAttribute('aria-valuemin', String(WIDTH.min));\n  const max = () => Math.max(WIDTH.min, Math.round(window.innerWidth * 0.9));\n  const setWidth = (width) => {\n    const clamped = Math.round(Math.min(max(), Math.max(WIDTH.min, width)));\n    host.style.setProperty('--devmode-width', `${clamped}px`);\n    splitter.setAttribute('aria-valuemax', String(max()));\n    splitter.setAttribute('aria-valuenow', String(clamped));\n    return clamped;\n  };\n  let width = setWidth(WIDTH.initial);\n  splitter.addEventListener('keydown', (event) => {\n    const keys = {\n      ArrowLeft: width + WIDTH.step,\n      ArrowRight: width - WIDTH.step,\n      Home: max(),\n      End: WIDTH.min,\n    };\n    if (event.key in keys) {\n      event.preventDefault();\n      width = setWidth(keys[event.key]);\n    }\n  });\n  splitter.addEventListener('pointerdown', (event) => {\n    event.preventDefault();\n    splitter.setPointerCapture?.(event.pointerId);\n    const move = (e) => {\n      width = setWidth(window.innerWidth - e.clientX);\n    };\n    const up = () => {\n      splitter.removeEventListener('pointermove', move);\n      splitter.removeEventListener('pointerup', up);\n    };\n    splitter.addEventListener('pointermove', move);\n    splitter.addEventListener('pointerup', up);\n  });\n  return { splitter, setWidth: (w) => (width = setWidth(w)) };\n}\n\n/**\n * Create the inspector panel and append it to the page.\n * @param {{ window: Window & typeof globalThis, layout: string,\n *   t: (key: string, params?: object) => string,\n *   onCommand: (command: string) => void,\n *   onView?: (view: string) => void }} options\n */\nexport function createInspector({ window, layout, t, onCommand, onView }) {\n  const doc = window.document;\n  const host = doc.createElement('ui-devmode-inspector');\n  host.dataset.uiDevmode = 'inspector';\n  const shadow = host.attachShadow({ mode: 'open' });\n  const { splitter, setWidth } = buildSplitter(host, shadow, t, window);\n  const frame = doc.createElement('div');\n  frame.className = 'frame';\n  shadow.append(splitter, frame);\n  doc.body.append(host);\n  const mounted = mountDocument(frame, layout, {\n    parseOptions: { vocabulary: LAYOUT_VOCABULARY },\n    kinds: LAYOUT_KINDS,\n    t,\n    baseCss: false,\n    css: INSPECTOR_CSS,\n  });\n  mounted.handle.flush?.();\n\n  let view = 'outline';\n  const tabs = buildTabs(shadow, (next) => {\n    view = next;\n    onView?.(next);\n  });\n  const button = (command) =>\n    shadow.querySelector(`button[data-command=\"${command}\"]`);\n  shadow.addEventListener('click', (event) => {\n    const target = event.target.closest?.('button[data-command]');\n    if (target && !target.disabled) {\n      onCommand(target.dataset.command);\n    }\n  });\n  const status = shadow.querySelector('[data-role=\"live\"]');\n  const selection = shadow.querySelector('[data-role=\"selection\"]');\n\n  return {\n    host,\n    shadow,\n    /** The panel element of a view (`outline`, `properties`, …). */\n    panel: (name) =>\n      shadow.querySelector(`[role=\"tabpanel\"][data-view=\"${name}\"]`),\n    get view() {\n      return view;\n    },\n    showView: (name, focus = false) => tabs.select(name, focus),\n    setPressed(command, pressed) {\n      button(command)?.setAttribute('aria-pressed', String(pressed));\n    },\n    setDisabled(command, disabled) {\n      const target = button(command);\n      if (target) {\n        target.disabled = disabled;\n      }\n    },\n    setSelection(textContent) {\n      selection.textContent = textContent;\n    },\n    announce(textContent) {\n      status.textContent = textContent;\n    },\n    setWidth,\n    /** Whether an event happened inside the panel. */\n    contains: (event) => event.composedPath?.().includes(host) ?? false,\n    destroy() {\n      mounted.handle.destroy();\n      host.remove();\n    },\n  };\n}\n/**\n * An open dev mode: the overlay, the inspector and the wiring between them,\n * the page and the configuration. `index.js` loads this module with a\n * dynamic `import()` only when dev mode opens, so a page whose policy\n * disables dev mode never downloads it (nor the inspector, the overlay and\n * the model it imports).\n */\n\nimport { defaultVocabulary, parse } from '@link-foundation/ui-core';\nimport { readStyles } from '@link-foundation/ui-style';\nimport { readTokens, resolveTokens } from '@link-foundation/ui-tokens';\nimport {\n  ancestorsOf,\n  animationsOf,\n  matchingStyles,\n  sourceOf,\n  tokensUsed,\n} from './details.js';\nimport { createInspector, loadLayout } from './inspector.js';\nimport {\n  applyEdit,\n  buildOutline,\n  DevModeError,\n  discardSession,\n  isLocked,\n  propertyRows,\n  resetProperty,\n  saveSession,\n  topWritableLayer,\n} from './model.js';\nimport { openDefaultsDialog } from './defaults-dialog.js';\nimport { createOverlay } from './overlay.js';\nimport {\n  renderAnimations,\n  renderEmpty,\n  renderOutline,\n  renderProperties,\n  renderSource,\n  renderStyles,\n  renderTokens,\n} from './views.js';\n\n/** The events pick mode takes from the page (the app never sees them). */\nconst PICK_EVENTS = [\n  'pointerdown',\n  'mousedown',\n  'pointerup',\n  'mouseup',\n  'click',\n  'dblclick',\n  'auxclick',\n];\n\n/**\n * The tree of the document read from the effective configuration, for a\n * page that passes no ui-store store. Same shape as a store.\n */\nexport function documentTree(config) {\n  let doc = null;\n  const parents = new Map();\n  const load = () => {\n    if (doc === null) {\n      doc = config.effective();\n      parents.clear();\n      const walk = (node, parent) => {\n        parents.set(node.id, parent);\n        (node.children ?? []).forEach((child) => walk(child, node.id));\n      };\n      doc.roots.forEach((node) => walk(node, null));\n    }\n    return doc;\n  };\n  return {\n    get: (id) => load().byId.get(id),\n    roots: () => load().roots.map((node) => node.id),\n    children: (id) =>\n      (load().byId.get(id)?.children ?? []).map((node) => node.id),\n    parentOf: (id) => (load(), parents.get(id) ?? null),\n    toDocument: load,\n    subscribe: (listener) =>\n      config.subscribe((...args) => {\n        doc = null;\n        listener(...args);\n      }),\n  };\n}\n\n/** The `theme` atom of the first root element, if any. */\nfunction themeOf(tree) {\n  const [first] = tree.roots();\n  const property = tree.get(first)?.properties?.find((p) => p.name === 'theme');\n  const value = property?.values?.[0];\n  return typeof value === 'string' ? value : undefined;\n}\n\n/** The resolved tokens: [REDACTED] ui-tokens map, or tokens.lino text. */\nfunction readTokenMap(tokens, theme) {\n  if (tokens instanceof Map) {\n    return tokens;\n  }\n  if (typeof tokens !== 'string') {\n    return new Map();\n  }\n  const { sets } = readTokens(tokens);\n  const setId = [theme].find((id) => sets.has(id)) ?? [...sets.keys()][0];\n  return setId === undefined ? new Map() : resolveTokens(sets, setId);\n}\n\n/** The animation nodes: of the document and of the `animations` option. */\nfunction animationNodes(tree, animations) {\n  const extra =\n    typeof animations === 'string'\n      ? parse(animations).roots\n      : (animations ?? []);\n  const own = [];\n  const walk = (node) => {\n    if (node.kind === 'animation') {\n      own.push(node);\n    }\n    (node.children ?? []).forEach(walk);\n  };\n  tree.toDocument().roots.forEach(walk);\n  return [...own, ...extra];\n}\n\n/** The source nodes of the read-only tabs (styles, tokens, animations). */\nfunction readSources(options, tree) {\n  const theme = options.theme ?? themeOf(tree);\n  return {\n    rules:\n      typeof options.styles === 'string'\n        ? readStyles(options.styles).rules\n        : (options.styles ?? []),\n    tokens: rea…ens, theme),\n    animations: () => animationNodes(tree, options.animations),\n  };\n}\n\n/** The token value of the configuration: a `(token path …)` of a theme. */\nfunction tokenOverride(config, tree) {\n  const themes = [];\n  const walk = (id) => {\n    if (tree.get(id)?.kind === 'theme') {\n      themes.push(id);\n    }\n    tree.children(id).forEach(walk);\n  };\n  tree.roots().forEach(walk);\n  return (path) => {\n    for (const id of themes) {\n      const found = config.resolve(id, 'token', path);\n      if (found?.value !== undefined) {\n        return found;\n      }\n    }\n    return undefined;\n  };\n}\n\n/** The `[data-link-id]` element of an event inside the root, if any. */\nfunction pickedNode(event, root) {\n  const path = event.composedPath?.() ?? [event.target];\n  for (const node of path) {\n    if (\n      node?.nodeType === 1 &&\n      node.hasAttribute('data-link-id') &&\n      root.contains(node)\n    ) {\n      return node;\n    }\n  }\n  return null;\n}\n\n/** The views of the selection: the property grid and the read-only tabs. */\nfunction renderDetails(ctx, id) {\n  const { tree, inspector, t, sources } = ctx;\n  const rows = ctx.renderGrid(id);\n  const styles = matchingStyles(\n    tree.get(id),\n    ancestorsOf(id, tree),\n    sources.rules\n  );\n  const animations = animationsOf(id, sources.animations());\n  const tokens = tok…(\n    { rows, styles, animations },\n    sources.tokens,\n    sources.overrideOf\n  );\n  renderStyles(inspector.panel('styles'), { id, styles }, { t });\n  renderTokens(inspector.panel('tokens'), { id, tokens }, { t });\n  renderAnimations(inspector.panel('animations'), { id, animations }, { t });\n  const node = tree.toDocument().byId.get(id);\n  const source = node ? sourceOf(node) : '';\n  renderSource(inspector.panel('source'), { id, source }, { t });\n}\n\nconst DETAIL_VIEWS = ['properties', 'styles', 'tokens', 'animations', 'source'];\n\n/** The property grid, rebuilt only when its rows change. */\nfunction gridRenderer(ctx) {\n  let grid = null;\n  let gridKey = '';\n  const { config, policy, inspector, t } = ctx;\n  const edit = (row, value) => {\n    try {\n      ctx.applyRow(ctx.state.selected, row, value);\n      return null;\n    } catch (error) {\n      if (error instanceof DevModeError) {\n        inspector.announce(t('status.error', { message: error.message }));\n        return error.message;\n      }\n      throw error;\n    }\n  };\n  const reset = (row) => {\n    const { name, key, label } = row;\n    const layer = resetProperty(\n      config,\n      { id: ctx.state.selected, name, key },\n      { policy, parentOf: ctx.parentOf }\n    );\n    inspector.announce(\n      layer\n        ? t('status.reset', { name: label, layer })\n        : t('status.nothing', { name: label })\n    );\n  };\n  return {\n    clear() {\n      grid = null;\n      gridKey = '';\n    },\n    render(id) {\n      const rows = ctx.rowsOf(id);\n      const key = `${id} ${rows.map((r) => `${r.name}/${r.key ?? ''}`).join(' ')}`;\n      if (grid && gridKey === key) {\n        grid.update(rows);\n        return rows;\n      }\n      gridKey = key;\n      grid = renderProperties(\n        inspector.panel('properties'),\n        {\n          id,\n          rows,\n          locked: isLocked(policy, id, ctx.parentOf),\n          writable: policy.writeLayers.length > 0,\n          tokenPaths: [...ctx.sources.tokens.keys()],\n        },\n        { t, onEdit: edit, onReset: reset }\n      );\n      return rows;\n    },\n  };\n}\n\n/** The outline, the selection and the refresh after a change. */\nfunction selectionController(ctx) {\n  const { tree, inspector, overlay, t, state } = ctx;\n  let outlineKey = '';\n  let outline = null;\n  const grid = gridRenderer(ctx);\n  ctx.renderGrid = grid.render;\n  const renderViews = () => {\n    const id = state.selected;\n    if (id === null) {\n      grid.clear();\n      DETAIL_VIEWS.forEach((view) => renderEmpty(inspector.panel(view), { t }));\n    } else {\n      renderDetails(ctx, id);\n    }\n  };\n  const renderTree = () => {\n    const next = buildOutline(tree);\n    const key = JSON.stringify(next);\n    if (key !== outlineKey) {\n      outlineKey = key;\n      outline = renderOutline(inspector.panel('outline'), next, {\n        t,\n        onSelect: (id) => select(id),\n      });\n    }\n    outline.select(state.selected);\n  };\n  const showSelection = () => {\n    const id = state.selected;\n    overlay.show('selected', ctx.target(id));\n    inspector.setSelection(\n      id === null\n        ? t('selection.none')\n        : t('selection.current', { id, type: ctx.typeOf(id) })\n    );\n  };\n  function select(id) {\n    state.selected =\n      id !== null && id !== undefined && tree.get(id) ? id : null;\n    outline.select(state.selected);\n    showSelection();\n    renderViews();\n    return state.selected;\n  }\n  const refresh = () => {\n    renderTree();\n    if (state.selected !== null && !tree.get(state.selected)) {\n      select(null);\n      return;\n    }\n    if (state.selected !== null) {\n      renderDetails(ctx, state.selected);\n    }\n    showSelection();\n    overlay.update();\n  };\n  return { renderTree, select, refresh };\n}\n\n/**\n * Pick mode: hovering the page highlights the element under the pointer,\n * a click selects it; the pointer events of a pick never reach the app.\n */\nfunction installPicking(ctx, listen, select) {\n  const { window, root, inspector, overlay, state } = ctx;\n  const own = (event) =>\n    inspector.contains(event) ||\n    (event.composedPath?.() ?? []).includes(overlay.host);\n  listen(\n    window,\n    'pointermove',\n    (event) => {\n      if (state.picking && !own(event)) {\n        const node = pickedNode(event, root);\n        const id = node?.getAttribute('data-link-id') ?? null;\n        overlay.show('hover', ctx.target(id));\n      }\n    },\n    true\n  );\n  for (const type of PICK_EVENTS) {\n    listen(\n      window,\n      type,\n      (event) => {\n        const node =\n          state.picking && !own(event) ? pickedNode(event, root) : null;\n        if (node === null) {\n          return;\n        }\n        event.preventDefault();\n        event.stopImmediatePropagation();\n        if (type === 'click') {\n          select(node.getAttribute('data-link-id'));\n        }\n      },\n      true\n    );\n  }\n}\n\n/** The shared state and helpers of an open dev mode. */\nasync function createContext(options) {\n  const { window, root, config, policy } = options;\n  const tree = options.store ?? documentTree(config);\n  const vocabulary = options.vocabulary ?? defaultVocabulary();\n  const parentOf = (id) => tree.parentOf(id);\n  const modelOptions = {\n    policy,\n    vocabulary,\n    parentOf,\n    getElement: (id) => tree.get(id),\n  };\n  const editLayer = policy.writeLayers.includes('session')\n    ? 'session'\n    : topWritableLayer(policy);\n  const typeOf = (id) => tree.get(id)?.kind ?? '';\n  const nodeFor = (id) =>\n    options.handle?.nodeFor?.(id) ??\n    [...root.querySelectorAll('[data-link-id]')].find(\n      (node) => node.getAttribute('data-link-id') === id\n    ) ??\n    null;\n  const rowsOf = (id) =>\n    tree.get(id) ? propertyRows(tree.get(id), config, modelOptions) : [];\n  return {\n    ...options,\n    layout: options.layout ?? (await loadLayout()),\n    tree,\n    parentOf,\n    typeOf,\n    rowsOf,\n    sources: {\n      ...readSources(options, tree),\n      overrideOf: tokenOverride(config, tree),\n    },\n    state: { selected: null, picking: false, closed: false },\n    target(id) {\n      const node = id === null ? null : nodeFor(id);\n      return node ? { node, id, type: typeOf(id) } : null;\n    },\n    /** Write a property of the grid (a row, or a name) to the session. */\n    applyRow(id, row, value) {\n      return applyEdit(\n        config,\n        { id, name: row.name, key: row.key ?? null, value, layer: editLayer },\n        modelOptions\n      );\n    },\n    nameRow: (id, name) =>\n      rowsOf(id).find((r) => r.label === name || r.name === name) ?? {\n        name,\n        key: null,\n      },\n    restoreFocus: window.document.activeElement,\n  };\n}\n\n/** The toolbar commands. */\nfunction commandsOf(ctx, close) {\n  const { config, policy, inspector, t } = ctx;\n  return {\n    defaults() {\n      ctx.setPicking(false);\n      ctx.defaultsDialog?.close();\n      ctx.defaultsDialog = openDefaultsDialog({\n        window: ctx.window,\n        config,\n        policy,\n        t,\n      });\n    },\n    pick: () => ctx.setPicking(!ctx.state.picking),\n    save() {\n      const count = saveSession(config, { policy });\n      inspector.announce(t('status.saved', { count }));\n    },\n    discard() {\n      const count = discardSession(config);\n      inspector.announce(t('status.discarded', { count }));\n    },\n    close,\n  };\n}\n\n/**\n * Open dev mode over a rendered page.\n * @param {{ window: Window & typeof globalThis, root: Element,\n *   config: object, policy: import('./policy.js').DevModePolicy,\n *   store?: object, handle?: { nodeFor?: (id: string) => Element|null },\n *   styles?: string|object[], tokens?: string|Map<string, object>,\n *   theme?: string, animations?: string|object[], vocabulary?: object,\n *   layout?: string, t: (key: string, params?: object) => string,\n *   onClose?: () => void }} options\n * @returns {Promise<DevModeSession>}\n *\n * @typedef {object} DevModeSession\n * @property {(id: string|null) => string|null} select\n * @property {() => { id: string, type: string }|null} getSelection\n * @property {(id: string, name: string, value: unknown) => object} setProperty\n * @property {(picking: boolean) => void} setPicking\n * @property {() => boolean} isPicking\n * @property {() => void} close\n */\nexport async function openSession(options) {\n  const ctx = await createContext(options);\n  const { window, config, policy, t, state } = ctx;\n  const cleanups = [];\n  const listen = (target, type, listener, capture = false) => {\n    target.addEventListener(type, listener, capture);\n    cleanups.push(() => target.removeEventListener(type, listener, capture));\n  };\n  let commands = {};\n  ctx.overlay = createOverlay({\n    document: window.document,\n    label: (id, type) => t('overlay.label', { id, type }),\n  });\n  ctx.inspector = createInspector({\n    window,\n    layout: ctx.layout,\n    t,\n    onCommand: (command) => commands[command]?.(),\n  });\n  const { inspector, overlay } = ctx;\n  const view = selectionController(ctx);\n  ctx.setPicking = (picking) => {\n    state.picking = Boolean(picking);\n    inspector.setPressed('pick', state.picking);\n    if (!state.picking) {\n      overlay.show('hover', null);\n    }\n    inspector.announce(state.picking ? t('selection.picking') : '');\n  };\n\n  // Changes of the store or the configuration, scrolling and resizing are\n  // coalesced to one update per frame.\n  let frame = null;\n  const raf =\n    window.requestAnimationFrame?.bind(window) ??\n    ((callback) => window.setTimeout(callback, 16));\n  const schedule = () => {\n    frame ??= raf(() => {\n      frame = null;\n      if (!state.closed) {\n        view.refresh();\n      }\n    });\n  };\n  const reposition = () => overlay.update();\n\n  const close = () => {\n    if (state.closed) {\n      return;\n    }\n    state.closed = true;\n    ctx.defaultsDialog?.close();\n    cleanups.splice(0).forEach((cleanup) => cleanup());\n    inspector.destroy();\n    overlay.destroy();\n    if (ctx.restoreFocus?.isConnected) {\n      ctx.restoreFocus.focus?.();\n    }\n    options.onClose?.();\n  };\n  commands = commandsOf(ctx, close);\n  if (!policy.writeLayers.includes('user')) {\n    inspector.setDisabled('save', true);\n  }\n  if (!policy.writeLayers.includes('session')) {\n    inspector.setDisabled('discard', true);\n  }\n\n  installPicking(ctx, listen, view.select);\n  listen(\n    window,\n    'keydown',\n    (event) => {\n      if (\n        event.key === 'Escape' &&\n        !event.defaultPrevented &&\n        !ctx.defaultsDialog?.host.isConnected\n      ) {\n        event.preventDefault();\n        if (state.picking) {\n          ctx.setPicking(false);\n        } else {\n          close();\n        }\n     