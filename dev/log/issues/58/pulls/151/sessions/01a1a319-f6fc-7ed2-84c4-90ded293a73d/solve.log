[2026-11-03T20:41:13.504Z] [STDOUT] {"type":"item.completed","item":{"id":"item_140","type":"command_execution","command":"/bin/bash -lc 'head -n 90 assets/assets.lino; cat scripts/check-assets.mjs | head -n 80; cat docs/licensing.md | tail -n 75; cat packages/ui-devmode-extension/scripts/package.mjs; git diff packages/ui-devmode/src/inspector.js; cat .gitignore | tail -n 40'","aggregated_output":"links-ui-logo: asset\n  kind image\n  files 'assets/links-ui-logo.svg'\n  license CC0-1.0\n  copyright none\n\nicon-attach: asset\n  kind icon\n  files 'assets/icons/own/attach.svg'\n  license CC0-1.0\n  copyright none\n\nicon-check: asset\n  kind icon\n  files 'assets/icons/own/check.svg'\n  license CC0-1.0\n  copyright none\n\nicon-chevron-down: asset\n  kind icon\n  files 'assets/icons/own/chevron-down.svg'\n  license CC0-1.0\n  copyright none\n\nicon-chevron-left: asset\n  kind icon\n  files 'assets/icons/own/chevron-left.svg'\n  license CC0-1.0\n  copyright none\n\nicon-chevron-right: asset\n  kind icon\n  files 'assets/icons/own/chevron-right.svg'\n  license CC0-1.0\n  copyright none\n\nicon-chevron-up: asset\n  kind icon\n  files 'assets/icons/own/chevron-up.svg'\n  license CC0-1.0\n  copyright none\n\nicon-close: asset\n  kind icon\n  files 'assets/icons/own/close.svg'\n  license CC0-1.0\n  copyright none\n\nicon-copy: asset\n  kind icon\n  files 'assets/icons/own/copy.svg'\n  license CC0-1.0\n  copyright none\n\nicon-dock-bottom: asset\n  kind icon\n  files 'assets/icons/own/dock-bottom.svg'\n  license CC0-1.0\n  copyright none\n\nicon-dock-left: asset\n  kind icon\n  files 'assets/icons/own/dock-left.svg'\n  license CC0-1.0\n  copyright none\n\nicon-dock-right: asset\n  kind icon\n  files 'assets/icons/own/dock-right.svg'\n  license CC0-1.0\n  copyright none\n\nicon-drag-handle: asset\n  kind icon\n  files 'assets/icons/own/drag-handle.svg'\n  license CC0-1.0\n  copyright none\n\nicon-error: asset\n  kind icon\n  files 'assets/icons/own/error.svg'\n  license CC0-1.0\n  copyright none\n\nicon-fit: asset\n  kind icon\n  files 'assets/icons/own/fit.svg'\n  license CC0-1.0\n  copyright none\n\n#!/usr/bin/env node\n// Check that every file under assets/ has exactly one record in\n// assets/assets.lino, that every record follows the licence policy in\n// docs/licensing.md, and that REUSE.toml matches the records.\n//\n//   node scripts/check-assets.mjs            # check, exit 1 on problems\n//   node scripts/check-assets.mjs --write    # regenerate REUSE.toml\n//   node scripts/check-assets.mjs --root DIR # check another checkout\n\nimport { existsSync, readFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport {\n  generateReuseToml,\n  listAssetFiles,\n  parseAssetRecords,\n  runCli,\n  syncGeneratedFile,\n  validateAssetRecords,\n} from './lib/asset-records.mjs';\n\nexport const RECORDS_PATH = 'assets/assets.lino';\nexport const REUSE_PATH = 'REUSE.toml';\n\n/**\n * @param {string} root repository root\n * @param {{write?: boolean}} [options]\n * @returns {{errors: string[], wrote: boolean}}\n */\nexport function checkAssets(root, { write = false } = {}) {\n  const recordsFile = join(root, RECORDS_PATH);\n  const text = existsSync(recordsFile) ? readFileSync(recordsFile, 'utf8') : '';\n  const records = parseAssetRecords(text);\n  const files = listAssetFiles(root);\n  const { errors } = validateAssetRecords(records, files);\n  const { stale } = syncGeneratedFile(\n    join(root, REUSE_PATH),\n    generateReuseToml(records),\n    { write }\n  );\n  if (stale && !write) {\n    errors.push(\n      `${REUSE_PATH} is out of date; run: node scripts/check-assets.mjs --write`\n    );\n  }\n  return { errors, wrote: stale && write };\n}\n\nfunction main(root, argv) {\n  const { errors, wrote } = checkAssets(root, {\n    write: argv.includes('--write'),\n  });\n  if (wrote) {\n    console.log(`Wrote ${REUSE_PATH}`);\n  }\n  if (errors.length > 0) {\n    for (const error of errors) {\n      console.error(`::error::${error}`);\n    }\n    console.error(\n      `\\n${errors.length} asset licensing problem(s). See docs/licensing.md.`\n    );\n    return 1;\n  }\n  console.log('Asset records and REUSE.toml are consistent.');\n  return 0;\n}\n\nrunCli(import.meta.url, main);\n| anime-avatar `ACS_GF2_MMD_MODEL_ARCHIVES`               | Hot-links about 70 proprietary SUNBORN Girls' Frontline 2 archives.                                                          | **Denied.** Neither bundled nor linked.                                                                                                     |\n| anime-avatar DamagedHelmet model                        | Licensed CC-BY-NC.                                                                                                           | **Denied** (non-commercial).                                                                                                                |\n| anime-avatar licence strings \"See repository\", \"CC-ish\" | Not SPDX identifiers.                                                                                                        | **Denied** until replaced with an SPDX expression.                                                                                          |\n| konard.github.io                                        | No LICENSE file (GitHub reports `license: null`).                                                                            | **Denied** until the owner relicenses it upstream. Nothing may be copied from it.                                                           |\n| meta-sovereign-chat `icons.js` (Lucide shapes)          | Lucide is ISC: permissive, but not public domain.                                                                            | **Allowed** with a third-party record: `(license ISC)`, `(copyright 'Lucide Contributors')`, `source` and `notice` links.                   |\n\nPrior art: anime-avatar `attributionRequired()` and `AttributionOverlay`\n([konard/anime-avatar#19](https://github.com/konard/anime-avatar/issues/19)).\nUnlike them, we decide attribution from explicit fields, not from\nlicence-string heuristics.\n\n## Record format\n\n`assets/assets.lino` holds one Links Notation link per asset or asset group:\n`(<id>: asset (field value)...)`. It is parsed with the official\n`links-notation` package.\n\n| Field              | Required        | Value                                                                      |\n| ------------------ | --------------- | -------------------------------------------------------------------------- |\n| `kind`             | yes             | `icon`, `image`, `font`, `sound`, `model`, `animation` or `data`           |\n| `files`            | yes             | one or more quoted repository paths or globs under `assets/`               |\n| `license`          | yes             | an SPDX expression; quote it if it contains spaces (`'MIT OR Apache-2.0'`) |\n| `copyright`        | yes             | quoted text, or `none` for our own CC0-1.0 (or Unlicense) assets           |\n| `source`           | third-party     | a quoted URL of the asset                                                  |\n| `notice`           | third-party     | a quoted URL of the licence text                                           |\n| `attribution`      | no (`none`)     | `required` or `none`                                                       |\n| `attribution-text` | no              | quoted text to show wherever the asset is credited                         |\n| `commercial-use`   | no              | `yes` or `no`                                                              |\n| `modified`         | no              | `yes` or `no`                                                              |\n| `opt-in`           | opt-in licences | `true`                                                                     |\n\nA record is third-party when its `copyright` is not `none`.\n\n```lino\nlucide-check: asset\n  kind icon\n  files 'assets/icons/lucide/check.svg'\n  source 'https://lucide.dev/icons/check'\n  license ISC\n  copyright 'Lucide Contributors'\n  notice 'https://github.com/lucide-icons/lucide/blob/main/LICENSE'\n\nlinks-ui-logo: asset\n  kind image\n  files 'assets/links-ui-logo.svg'\n  license CC0-1.0\n  copyright none\n```\n\n## Checks\n\n- `npm run check:assets` (`scripts/check-assets.mjs`) fails when a file under\n  `assets/` (other than `assets.lino`, `README.md` and `ATTRIBUTIONS.md`)\n  matches no record or more than one, when a record matches no file or misses\n  a field, when a licence is denied or is opt-in without `(opt-in true)`, when\n  a third-party record has no `source` or `notice`, and when `REUSE.toml` is\n  not what `node scripts/check-assets.mjs --write` would generate.\n- `npm run assets:attributions` (`scripts/render-attributions.mjs`) writes\n  [`assets/ATTRIBUTIONS.md`](../assets/ATTRIBUTIONS.md), grouped by licence;\n  `--check` fails when it is stale. Its `renderAttributions(records, {format})`\n  export renders `markdown`, `html` or `lino` for later in-app use.\n- `pipx run reuse lint` checks REUSE compliance. The `reuse` tool is\n  GPL-3.0; it runs in CI only and is never shipped or imported.\n\nThe [Licensing workflow](../.github/workflows/licensing.yml) runs all three on\npull requests and on pushes to `main`.\n\n## Adding an asset\n\n1. Put the file under `assets/`.\n2. Add or extend a record in `assets/assets.lino`.\n3. Run `node scripts/check-assets.mjs --write` and\n   `node scripts/render-attributions.mjs`, and commit `REUSE.toml` and\n   `assets/ATTRIBUTIONS.md`.\n4. If the licence is new, add its text with `pipx run reuse download --all`.\nimport { mkdir, copyFile } from 'node:fs/promises';\nimport { execFileSync } from 'node:child_process';\nimport { fileURLToPath } from 'node:url';\nconst root = fileURLToPath(new globalThis.URL('..', import.meta.url));\nexecFileSync(\n  process.execPath,\n  [`${root}/../ui-devmode/scripts/build-bookmarklet.mjs`],\n  { stdio: 'inherit' }\n);\nawait mkdir(`${root}/dist/unpacked`, { recursive: true });\nfor (const file of ['manifest.json', 'background.js']) {\n  await copyFile(`${root}/${file}`, `${root}/dist/unpacked/${file}`);\n}\nawait copyFile(\n  `${root}/../ui-devmode/dist/devmode.js`,\n  `${root}/dist/unpacked/devmode.js`\n);\nexecFileSync(\n  'zip',\n  [\n    '-q',\n    '-X',\n    '../ui-devmode-extension.zip',\n    'manifest.json',\n    'background.js',\n    'devmode.js',\n  ],\n  { cwd: `${root}/dist/unpacked`, stdio: 'inherit' }\n);\nconsole.log(`Extension: ${root}/dist/ui-devmode-extension.zip`);\ndiff --git a/packages/ui-devmode/src/inspector.js b/packages/ui-devmode/src/inspector.js\nindex 202544e..8a67f67 100644\n--- a/packages/ui-devmode/src/inspector.js\n+++ b/packages/ui-devmode/src/inspector.js\n@@ -270,7 +270,14 @@ function buildSplitter(host, shadow, t, window) {\n  *   onCommand: (command: string) => void,\n  *   onView?: (view: string) => void }} options\n  */\n-export function createInspector({ window, layout, t, onCommand, onView }) {\n+export function createInspector({\n+  window,\n+  layout,\n+  t,\n+  onCommand,\n+  onView,\n+  container = window.document.body,\n+}) {\n   const doc = window.document;\n   const host = doc.createElement('ui-devmode-inspector');\n   host.dataset.uiDevmode = 'inspector';\n@@ -279,7 +286,7 @@ export function createInspector({ window, layout, t, onCommand, onView }) {\n   const frame = doc.createElement('div');\n   frame.className = 'frame';\n   shadow.append(splitter, frame);\n-  doc.body.append(host);\n+  container.append(host);\n   const mounted = mountDocument(frame, layout, {\n     parseOptions: { vocabulary: LAYOUT_VOCABULARY },\n     kinds: LAYOUT_KINDS,\n# DynamoDB Local files\n.dynamodb/\n\n# Firebase cache directory\n.firebase/\n\n# TernJS port file\n.tern-port\n\n# Stores VSCode versions used for testing VSCode extensions\n.vscode-test\n\n# yarn v3\n.pnp.*\n.yarn/*\n!.yarn/patches\n!.yarn/plugins\n!.yarn/releases\n!.yarn/sdks\n!.yarn/versions\n\n# Vite logs files\nvite.config.js.timestamp-*\nvite.config.ts.timestamp-*\n\n# jscpd reports\nreports/\n\n# Playwright UI tests\nplaywright-report/\ntest-results/\nblob-report/\n\n# SwiftPM build output (native/swift)\n.build/\n.swiftpm/\nPackage.resolved\n\n# Locally downloaded CI logs used while investigating failures\nci-logs/\n","exit_code":0,"status":"completed"}}
