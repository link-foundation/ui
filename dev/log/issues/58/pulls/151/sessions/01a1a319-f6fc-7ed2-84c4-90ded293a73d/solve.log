[2026-11-03T20:44:02.911Z] [STDOUT] {"type":"item.completed","item":{"id":"item_176","type":"command_execution","command":"/bin/bash -lc \"git diff --cached -- . ':\"'!package-lock.json'\"' ':\"'!docs/screenshots/*'\"' > /tmp/issue-58-review.diff; wc -l /tmp/issue-58-review.diff; sed -n '1,1500p' /tmp/issue-58-review.diff\"","aggregated_output":"2195 /tmp/issue-58-review.diff\ndiff --git a/.changeset/foreign-page-devmode.md b/.changeset/foreign-page-devmode.md\nnew file mode 100644\nindex 0000000..2788a13\n--- /dev/null\n+++ b/.changeset/foreign-page-devmode.md\n@@ -0,0 +1,9 @@\n+---\n+'@link-foundation/ui-devmode': minor\n+'@link-foundation/ui-convert': minor\n+'@link-foundation/ui-dom': patch\n+---\n+\n+Inspect and edit foreign DOM pages with persistent LiNo overrides, subtree export,\n+a configurable bookmarklet and a private Manifest V3 extension. Allow DOM imports\n+to exclude inspector hosts before assigning structural IDs.\ndiff --git a/.github/workflows/ui-tests.yml b/.github/workflows/ui-tests.yml\nindex d6c4d09..9da00d1 100644\n--- a/.github/workflows/ui-tests.yml\n+++ b/.github/workflows/ui-tests.yml\n@@ -62,6 +62,9 @@ jobs:\n       - name: Build icon sets\n         run: npm run build:icons\n \n+      - name: Build foreign dev mode and unpacked extension\n+        run: npm run build --workspace @link-foundation/ui-devmode-extension\n+\n       - name: Install Expo example dependencies\n         run: npm ci --prefix examples/react-native --no-audit --no-fund\n \ndiff --git a/experiments/issue-58/plan.md b/experiments/issue-58/plan.md\nnew file mode 100644\nindex 0000000..5c000db\n--- /dev/null\n+++ b/experiments/issue-58/plan.md\n@@ -0,0 +1,18 @@\n+# Issue 58 implementation and verification\n+\n+Dependencies #25, #54 and related #55 are closed; no required sub-issues or comments.\n+\n+- [ ] Foreign adapter: importer IDs, WeakMap reverse index, ignored inspector hosts,\n+      safe text/attribute/style writes recorded in session, 200 ms DOM refresh,\n+      stable selection, opaque shadow hosts.\n+- [ ] Async per-origin/path localStorage and extension storage persistence;\n+      restore edits; LiNo overrides and selected subtree copy/export.\n+- [ ] Shared inspector adapter integration preserving ui-dom behavior;\n+      bundled entry, toggle, fixed shadow host, configurable bookmarklet loader.\n+- [ ] Private MV3 extension: toolbar injection, activeTab/scripting/storage,\n+      zip packaging and real unpacked Chromium verification under strict CSP.\n+- [ ] Unit regression coverage, fixture and browser acceptance tests,\n+      accessibility and committed screenshot; README instructions and changesets.\n+- [ ] Review whole diff; four required gates on committed revision; push only\n+      prepared branch; inspect every CI result for exact SHA; update PR evidence\n+      and mark ready only after green CI. Merge default branch if needed.\ndiff --git a/experiments/issue-58/playwright.config.mjs b/experiments/issue-58/playwright.config.mjs\nnew file mode 100644\nindex 0000000..d10a841\n--- /dev/null\n+++ b/experiments/issue-58/playwright.config.mjs\n@@ -0,0 +1,14 @@\n+import config from '../../playwright.config.mjs';\n+// Set this to reuse an installed Chromium without another browser download.\n+const executablePath = process.env.UI_DEVMODE_CHROMIUM_EXECUTABLE;\n+export default {\n+  ...config,\n+  webServer: { ...config.webServer, cwd: process.cwd() },\n+  testDir: '../..',\n+  projects: [\n+    {\n+      ...config.projects[0],\n+      use: { ...config.projects[0].use, launchOptions: { executablePath } },\n+    },\n+  ],\n+};\ndiff --git a/packages/ui-convert/src/html/from-dom.js b/packages/ui-convert/src/html/from-dom.js\nindex 7bbfbb1..a3de921 100644\n--- a/packages/ui-convert/src/html/from-dom.js\n+++ b/packages/ui-convert/src/html/from-dom.js\n@@ -27,7 +27,7 @@ const TYPES = {\n  *   `dom.nodeLocation`) or `{ start, end }`\n  * @returns {import('./tree.js').Reader}\n  */\n-const domReader = (location) => ({\n+const domReader = (location, ignore) => ({\n   type: (node) => TYPES[node.nodeType] ?? 'other',\n   tag: (node) => node.localName,\n   attrs: (node) =>\n@@ -38,7 +38,7 @@ const domReader = (location) => ({\n       node.localName === 'template' && node.content\n         ? node.content.childNodes\n         : node.childNodes\n-    ),\n+    ).filter((child) => !ignore?.(child)),\n   span(node) {\n     const found = location?.(node);\n     if (!found) {\n@@ -58,5 +58,5 @@ const domReader = (location) => ({\n  * @returns {import('./tree.js').HtmlNode[]}\n  */\n export function readDom(root, options) {\n-  return readTree(domReader(options.location), root, options);\n+  return readTree(domReader(options.location, options.ignore), root, options);\n }\ndiff --git a/packages/ui-convert/src/index.d.ts b/packages/ui-convert/src/index.d.ts\nindex b529261..1123315 100644\n--- a/packages/ui-convert/src/index.d.ts\n+++ b/packages/ui-convert/src/index.d.ts\n@@ -76,6 +76,8 @@ export interface ImportHtmlOptions extends ImportOptions {\n }\n \n export interface ImportDomOptions extends ImportOptions {\n+  /** Exclude a node and its descendants before assigning IDs. */\n+  ignore?: (node: Node) => boolean;\n   /** Source offsets of a DOM node, when the host knows them. */\n   location?: (\n     node: unknown\ndiff --git a/packages/ui-devmode-extension/README.md b/packages/ui-devmode-extension/README.md\nnew file mode 100644\nindex 0000000..7b9ca0b\n--- /dev/null\n+++ b/packages/ui-devmode-extension/README.md\n@@ -0,0 +1,32 @@\n+# Links UI dev mode extension\n+\n+Private workspace: not published to npm or a browser store. Run:\n+\n+```bash\n+npm run build --workspace @link-foundation/ui-devmode-extension\n+```\n+\n+Requires `zip` on PATH. The script builds the shared dev mode bundle, writes\n+`dist/unpacked/{manifest.json,background.js,devmode.js}` and\n+`dist/ui-devmode-extension.zip`. In Chromium, open `chrome://extensions`, enable\n+Developer mode, click Load unpacked and choose `dist/unpacked`.\n+\n+Visit a regular HTML page and click the toolbar action (pin it if necessary).\n+Select a title, open Properties, edit text and style color. Reload the page and\n+click the action again: both changes return. The action toggles an open inspector.\n+Copy overrides as LiNo and Copy subtree as LiNo provide the migration artifacts.\n+Changes are saved in `chrome.storage.local`, isolated by origin and pathname.\n+The action grants `activeTab`; `scripting` injects the packaged `devmode.js` in\n+an isolated world. `storage` saves the LiNo. No broad host permissions are used.\n+\n+Unlike the bookmarklet, extension script injection works under page script CSP,\n+including `packages/ui-devmode/tests/fixtures/foreign-csp.html`. Internal browser\n+pages, extension store pages, and other restricted targets are unsupported.\n+Cross-origin iframe content and closed shadow roots are not traversed.\n+\n+The automated `foreign.e2e.mjs` test loads this unpacked folder in a persistent\n+Chromium context, activates the actual action handler through its service worker,\n+and verifies edits, storage, reload and strict CSP. This uses a test-only host\n+grant to simulate the activeTab grant Chrome supplies on a real toolbar click.\n+To verify manually, serve the repository, open the CSP fixture, click the toolbar\n+action, edit the first title and reload/reopen. See PR #151 for the screenshot.\ndiff --git a/packages/ui-devmode-extension/background.js b/packages/ui-devmode-extension/background.js\nnew file mode 100644\nindex 0000000..ac6c25b\n--- /dev/null\n+++ b/packages/ui-devmode-extension/background.js\n@@ -0,0 +1,16 @@\n+/* global chrome */\n+async function activateTab(tab) {\n+  if (!tab.id) {\n+    return;\n+  }\n+  try {\n+    await chrome.scripting.executeScript({\n+      target: { tabId: tab.id },\n+      files: ['devmode.js'],\n+    });\n+  } catch (error) {\n+    // Chrome's internal pages and other restricted targets cannot be inspected.\n+    console.warn('Links UI dev mode could not open:', error.message);\n+  }\n+}\n+chrome.action.onClicked.addListener(activateTab);\ndiff --git a/packages/ui-devmode-extension/manifest.json b/packages/ui-devmode-extension/manifest.json\nnew file mode 100644\nindex 0000000..23cc380\n--- /dev/null\n+++ b/packages/ui-devmode-extension/manifest.json\n@@ -0,0 +1,9 @@\n+{\n+  \"manifest_version\": 3,\n+  \"name\": \"Links UI dev mode\",\n+  \"version\": \"0.0.0\",\n+  \"description\": \"Inspect a live page and export edits as Links Notation.\",\n+  \"permissions\": [\"activeTab\", \"scripting\", \"storage\"],\n+  \"action\": { \"default_title\": \"Toggle Links UI dev mode\" },\n+  \"background\": { \"service_worker\": \"background.js\" }\n+}\ndiff --git a/packages/ui-devmode-extension/package.json b/packages/ui-devmode-extension/package.json\nnew file mode 100644\nindex 0000000..0a53113\n--- /dev/null\n+++ b/packages/ui-devmode-extension/package.json\n@@ -0,0 +1,10 @@\n+{\n+  \"name\": \"@link-foundation/ui-devmode-extension\",\n+  \"version\": \"0.0.0\",\n+  \"private\": true,\n+  \"type\": \"module\",\n+  \"license\": \"Unlicense\",\n+  \"scripts\": {\n+    \"build\": \"node scripts/package.mjs\"\n+  }\n+}\ndiff --git a/packages/ui-devmode-extension/scripts/package.mjs b/packages/ui-devmode-extension/scripts/package.mjs\nnew file mode 100644\nindex 0000000..9d48496\n--- /dev/null\n+++ b/packages/ui-devmode-extension/scripts/package.mjs\n@@ -0,0 +1,30 @@\n+import { mkdir, copyFile } from 'node:fs/promises';\n+import { execFileSync } from 'node:child_process';\n+import { fileURLToPath } from 'node:url';\n+const root = fileURLToPath(new globalThis.URL('..', import.meta.url));\n+execFileSync(\n+  process.execPath,\n+  [`${root}/../ui-devmode/scripts/build-bookmarklet.mjs`],\n+  { stdio: 'inherit' }\n+);\n+await mkdir(`${root}/dist/unpacked`, { recursive: true });\n+for (const file of ['manifest.json', 'background.js']) {\n+  await copyFile(`${root}/${file}`, `${root}/dist/unpacked/${file}`);\n+}\n+await copyFile(\n+  `${root}/../ui-devmode/dist/devmode.js`,\n+  `${root}/dist/unpacked/devmode.js`\n+);\n+execFileSync(\n+  'zip',\n+  [\n+    '-q',\n+    '-X',\n+    '../ui-devmode-extension.zip',\n+    'manifest.json',\n+    'background.js',\n+    'devmode.js',\n+  ],\n+  { cwd: `${root}/dist/unpacked`, stdio: 'inherit' }\n+);\n+console.log(`Extension: ${root}/dist/ui-devmode-extension.zip`);\ndiff --git a/packages/ui-devmode/README.md b/packages/ui-devmode/README.md\nindex e2b61d3..234e474 100644\n--- a/packages/ui-devmode/README.md\n+++ b/packages/ui-devmode/README.md\n@@ -221,3 +221,51 @@ site is sorted by element ID, property and token key. The codec exports\n The runnable example is `packages/ui-devmode/examples/?ui-dev`.\n `packages/ui-devmode/e2e/defaults.e2e.mjs` covers label editing, share preview,\n Keep/Discard, clipboard fallback, modal keyboard use, axe and URL budgets.\n+\n+## Foreign pages: bookmarklet and extension\n+\n+Dev mode also works on pages that do not use ui-dom. The foreign adapter uses\n+`importDom` from ui-convert, keeps node mappings in a WeakMap, and never adds\n+mapping attributes to the page. The same inspector lives in a fixed shadow host.\n+Pick an element, open Properties, and edit leaf `text`, `attr <name>` or\n+`style <property>` rows. Existing attributes and inline declarations are listed;\n+`attr title` and `style color` are available even when absent. Arbitrary safe\n+properties can also be set with\n+`linkUiForeignDevMode.setProperty(id, 'style background-color', '#eef')`.\n+Event attributes, script URLs, `srcdoc`, and whole-style attribute writes are\n+refused. Text edits cannot replace an element's children. Closed shadow roots\n+stay opaque; cross-origin iframe contents are not inspected.\n+\n+Changes write the session configuration layer and are automatically persisted\n+per origin and pathname as LiNo under `link-ui-devmode:<origin>:<pathname>`.\n+Reopening restores them; Save promotes the session to user and Discard removes\n+session edits. Reset restores the previous value, including an absent attribute.\n+DOM changes re-import after 200 ms; stable IDs keep their selection. Structural\n+IDs may change when siblings are inserted; use existing HTML IDs when possible.\n+Copy overrides as LiNo exports one `set` per changed property; Copy subtree as\n+LiNo exports the selected live subtree for migration. Clipboard denial presents\n+a selected textarea for manual copying. `whenSaved()` waits for pending writes;\n+`storageError` and `restoreError` expose unavailable storage or invalid data.\n+\n+Build with `npm run build --workspace @link-foundation/ui-devmode`. It writes\n+`dist/foreign.js` (one ES module), `dist/devmode.js` (the extension bundle) and\n+`dist/bookmarklet.txt`. Set `UI_DEVMODE_BUNDLE_URL=https://your-host/foreign.js`\n+at build time to configure the bookmarklet loader. Host the ES module with a\n+JavaScript content type and CORS permission for the inspected origin. The default\n+URL reserves the future documentation hosting location; self-host the bundle\n+until that location is deployed. Drag a bookmark whose URL is the contents of\n+`bookmarklet.txt` into the bookmarks bar, then click it on the page to toggle.\n+\n+**Strict Content Security Policy (CSP) blocks the bookmarklet**, including the\n+loader or its module request. Use the browser extension on these pages. The\n+`tests/fixtures/foreign-csp.html` fixture checks this with `script-src 'none'`.\n+The extension injects a packaged script in Chrome's isolated world and uses\n+`chrome.storage.local`; it does not fetch executable code from the web.\n+See [extension instructions](../ui-devmode-extension/README.md). Restricted\n+browser pages cannot be inspected. No Firefox support is claimed.\n+\n+For programmatic use, import `mountForeignDevMode` from\n+`@link-foundation/ui-devmode/foreign`; pass an optional `window`, inspector\n+`layout` LiNo, or async `{ getItem, setItem }` storage wrapper. The returned\n+controller supports select, exportOverrides, exportSubtree, close/toggle and\n+async destroy. Repeated mounting toggles the existing controller.\ndiff --git a/packages/ui-devmode/e2e/foreign.e2e.mjs b/packages/ui-devmode/e2e/foreign.e2e.mjs\nnew file mode 100644\nindex 0000000..c6c5d87\n--- /dev/null\n+++ b/packages/ui-devmode/e2e/foreign.e2e.mjs\n@@ -0,0 +1,238 @@\n+/* global chrome, activateTab */\n+import { mkdir, mkdtemp, readFile, writeFile, cp, rm } from 'node:fs/promises';\n+import { tmpdir } from 'node:os';\n+import path from 'node:path';\n+import { test, expect, chromium } from '@playwright/test';\n+import { expectAccessible } from '../../../tests/ui/helpers.mjs';\n+\n+const FIXTURE = '/packages/ui-devmode/tests/fixtures/foreign.html';\n+const CSP = FIXTURE.replace('foreign.html', 'foreign-csp.html');\n+const BUNDLE = path.resolve('packages/ui-devmode/dist/devmode.js');\n+const panel = (page) => page.locator('ui-foreign-devmode ui-devmode-inspector');\n+const row = (page, name) =>\n+  panel(page).locator(`tr[data-name=\"${name}\"] input`);\n+\n+// Build the delivery artifacts before starting the static server (see ui-tests.yml).\n+async function inject(page) {\n+  await page.addScriptTag({ path: BUNDLE });\n+  await page.evaluate(() => globalThis.linkUiForeignReady);\n+  await expect(panel(page)).toBeVisible();\n+}\n+\n+test('foreign outline, DOM isolation, edits, exports, reload, mutation and toggle', async ({\n+  page,\n+}, info) => {\n+  await page.goto(FIXTURE);\n+  const before = await page.locator('body').evaluate((node) => node.outerHTML);\n+  if (process.env.UPDATE_DOCS_SCREENSHOTS === '1') {\n+    await mkdir('docs/screenshots', { recursive: true });\n+    await page.screenshot({\n+      path: 'docs/screenshots/ui-devmode-foreign-before.png',\n+      caret: 'initial',\n+    });\n+  }\n+  await inject(page);\n+  expect(\n+    await page.locator('body').evaluate((node) => {\n+      const clone = node.cloneNode(true);\n+      clone.querySelector('ui-foreign-devmode').remove();\n+      return clone.outerHTML;\n+    })\n+  ).toBe(before);\n+  const ids = await page.evaluate(() => [\n+    ...globalThis.linkUiForeignDevMode.adapter.tree().toDocument().byId.keys(),\n+  ]);\n+  expect(\n+    await panel(page)\n+      .getByRole('treeitem')\n+      .evaluateAll((nodes) => nodes.map((n) => n.dataset.id))\n+  ).toEqual(ids);\n+  await page.locator('#card-title').click();\n+  await panel(page)\n+    .getByRole('tab', { name: 'Properties', exact: true })\n+    .click();\n+  await row(page, 'text').fill('Migrated card');\n+  await row(page, 'style color').fill('#b3261e');\n+  await expect(page.locator('#card-title')).toHaveText('Migrated card');\n+  await expect(page.locator('#card-title')).toHaveCSS(\n+    'color',\n+    'rgb(179, 38, 30)'\n+  );\n+  await page.evaluate(() => globalThis.linkUiForeignDevMode.whenSaved());\n+  const exported = await page.evaluate(() => ({\n+    patch: globalThis.linkUiForeignDevMode.exportOverrides(),\n+    subtree: globalThis.linkUiForeignDevMode.exportSubtree(),\n+  }));\n+  expect(exported.patch.count).toBe(2);\n+  expect(exported.subtree).toContain('Migrated card');\n+  expect(\n+    exported.patch.links[0].values.filter(\n+      (link) => Array.isArray(link) && link[0] === 'set'\n+    )\n+  ).toHaveLength(2);\n+  await expectAccessible(page, { include: 'ui-foreign-devmode' });\n+  if (\n+    process.env.UPDATE_DOCS_SCREENSHOTS === '1' &&\n+    info.project.name === 'chromium'\n+  ) {\n+    await mkdir('docs/screenshots', { recursive: true });\n+    await page.screenshot({ path: 'docs/screenshots/ui-devmode-foreign.png' });\n+  }\n+  await page.reload();\n+  await inject(page);\n+  await expect(page.locator('#card-title')).toHaveText('Migrated card');\n+  await expect(page.locator('#card-title')).toHaveCSS(\n+    'color',\n+    'rgb(179, 38, 30)'\n+  );\n+  await page.evaluate(() => {\n+    globalThis.linkUiForeignDevMode.select('card-title');\n+    const item = document.createElement('h2');\n+    item.id = 'new-title';\n+    item.textContent = 'New card';\n+    document.querySelector('main').append(item);\n+  });\n+  await expect\n+    .poll(() =>\n+      page.evaluate(\n+        () =>\n+          globalThis.linkUiForeignDevMode.adapter.nodeFor('new-title')\n+            ?.textContent\n+      )\n+    )\n+    .toBe('New card');\n+  expect(\n+    await page.evaluate(() => globalThis.linkUiForeignDevMode.getSelection().id)\n+  ).toBe('card-title');\n+  await page.evaluate(() => {\n+    document.querySelector('#card-title').remove();\n+  });\n+  await expect\n+    .poll(() =>\n+      page.evaluate(() => globalThis.linkUiForeignDevMode.getSelection())\n+    )\n+    .toBe(null);\n+  await page.addScriptTag({ path: BUNDLE });\n+  await page.evaluate(() => globalThis.linkUiForeignReady);\n+  await expect(panel(page)).toHaveCount(0);\n+});\n+\n+test('bookmarklet emits javascript URL and strict CSP blocks loader', async ({\n+  page,\n+}) => {\n+  const loader = await readFile(\n+    'packages/ui-devmode/dist/bookmarklet.txt',\n+    'utf8'\n+  );\n+  expect(loader.startsWith('javascript:')).toBe(true);\n+  await page.goto(FIXTURE);\n+  await page.addScriptTag({\n+    type: 'module',\n+    url: '/packages/ui-devmode/dist/foreign.js',\n+  });\n+  await page.evaluate(() => globalThis.linkUiForeignReady);\n+  await expect(panel(page)).toBeVisible();\n+  await page.goto(CSP);\n+  const blocked = await page.evaluate(\n+    () =>\n+      new Promise((resolve) => {\n+        document.addEventListener(\n+          'securitypolicyviolation',\n+          (event) => resolve(event.violatedDirective),\n+          { once: true }\n+        );\n+        const script = document.createElement('script');\n+        script.type = 'module';\n+        script.src = '/packages/ui-devmode/dist/foreign.js';\n+        document.documentElement.append(script);\n+      })\n+  );\n+  expect(blocked).toContain('script-src');\n+  await expect(panel(page)).toHaveCount(0);\n+});\n+\n+test('unpacked MV3 action edits and restores a strict CSP page in an isolated world', async ({\n+  browserName,\n+}) => {\n+  test.skip(\n+    browserName !== 'chromium',\n+    'Manifest V3 is a Chromium delivery channel'\n+  );\n+  const folder = await mkdtemp(path.join(tmpdir(), 'links-ui-extension-'));\n+  const extension = path.join(folder, 'unpacked');\n+  await cp('packages/ui-devmode-extension/dist/unpacked', extension, {\n+    recursive: true,\n+  });\n+  const manifest = JSON.parse(\n+    await readFile(path.join(extension, 'manifest.json'), 'utf8')\n+  );\n+  // Automation cannot click browser chrome. Grant only the fixture origin in this\n+  // temporary test copy, then dispatch the registered action listener in the worker.\n+  manifest.host_permissions = ['http://127.0.0.1/*'];\n+  await writeFile(\n+    path.join(extension, 'manifest.json'),\n+    JSON.stringify(manifest)\n+  );\n+  const context = await chromium.launchPersistentContext(\n+    path.join(folder, 'profile'),\n+    {\n+      channel: 'chromium',\n+      executablePath: process.env.UI_DEVMODE_CHROMIUM_EXECUTABLE,\n+      headless: true,\n+      args: [\n+        `--disable-extensions-except=${extension}`,\n+        `--load-extension=${extension}`,\n+      ],\n+    }\n+  );\n+  try {\n+    const worker =\n+      context.serviceWorkers()[0] ??\n+      (await context.waitForEvent('serviceworker'));\n+    const page = await context.newPage();\n+    await page.goto(`http://127.0.0.1:4173${CSP}`);\n+    const activate = () =>\n+      worker.evaluate(async () => {\n+        const [tab] = await chrome.tabs.query({\n+          url: 'http://127.0.0.1:4173/*',\n+        });\n+        await activateTab(tab);\n+      });\n+    await activate();\n+    await expect(panel(page)).toBeVisible();\n+    await page.locator('#card-title').click();\n+    await panel(page)\n+      .getByRole('tab', { name: 'Properties', exact: true })\n+      .click();\n+    await row(page, 'text').fill('Extension card');\n+    await row(page, 'style