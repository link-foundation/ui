} = await import('./session.js');\n    if (destroyed) {\n      return null;\n    }\n    return openSession({\n      ...options,\n      window,\n      root,\n      config,\n      policy,\n      t,\n      onClose() {\n        session = null;\n        publish(null);\n        options.onClose?.();\n      },\n    });\n  };\n\n  const controller = {\n    policy,\n    get isOpen() {\n      return session !== null;\n    },\n    /** Open dev mode (loads the inspector the first time). */\n    async open() {\n      if (!policy.enabled || destroyed) {\n        return false;\n      }\n      if (session) {\n        return true;\n      }\n      if (opening === null) {\n        const ticket = start().then((value) => {\n          if (opening !== ticket) {\n            // Closed (or destroyed) while the inspector was loading.\n            value?.close();\n            return null;\n          }\n          opening = null;\n          session = value;\n          if (value) {\n            publish(value);\n            options.onOpen?.();\n          }\n          return value;\n        });\n        opening = ticket;\n      }\n      return (await opening) !== null;\n    },\n    /** Close dev mode; the session and user layers stay as they are. */\n    close() {\n      opening = null;\n      session?.close();\n    },\n    /** Close dev mode when it is open, else open it. */\n    toggle() {\n      if (session || opening) {\n        controller.close();\n        return Promise.resolve(false);\n      }\n      return controller.open();\n    },\n    /** Open dev mode and select an element (`null` clears the selection). */\n    async select(id) {\n      return (await controller.open()) ? session.select(id) : null;\n    },\n    /** Close dev mode and remove its entry points. */\n    destroy() {\n      controller.close();\n      destroyed = true;\n      uninstall();\n    },\n  };\n\n  const uninstall = installActivation({\n    window,\n    policy,\n    onActivate: () => {\n      controller.open();\n    },