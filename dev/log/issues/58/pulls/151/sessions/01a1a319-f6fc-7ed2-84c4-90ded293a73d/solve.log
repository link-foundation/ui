ry.name))\n      : entry.name.endsWith('.js')\n        ? [join(dir, entry.name)]\n        : []\n  );\n}\n\ndescribe('lint: no code from text under ui-components/src', () => {\n  it('fails on a fixture with eval(', async () => {\n    const messages = await ruleMessages(\n      'export const run = (text) => eval(text);\\n',\n      'behavior/fixture.js'\n    );\n    expect(messages).toEqual([['no-eval', 2]]);\n  });\n\n  it('fails on new Function and string timers', async () => {\n    const messages = await ruleMessages(\n      [\n        \"export const make = (text) => new Function('x', text);\",\n        \"export const later = (text) => setTimeout('run(' + text + ')', 1);\",\n        '',\n      ].join('\\n'),\n      'a11y/fixture.js'\n    );\n    expect(messages).toEqual([\n      ['no-new-func', 2],\n      ['no-implied-eval', 2],\n    ]);\n  });\n\n  // Only the code-execution rules: formatting rules depend on the checkout\n  // (Windows checks out CRLF line breaks) and are checked by `npm run lint`.\n  it('passes the code-execution rules on the real sources', async () => {\n    const files = sourceFiles(SRC);\n    expect(files.length > 10).toBe(true);\n    for (const file of files) {\n      const [result] = await eslint.lintText(readFileSync(file, 'utf8'), {\n        filePath: file,\n      });\n      const errors = result.messages.filter((m) => RULES.includes(m.ruleId));\n      expect([file, errors]).toEqual([file, []]);\n    }\n  });\n});\nimport config from '../../playwright.config.mjs';\n// Set this to reuse an installed Chromium without another browser download.\nconst executablePath = process.env.UI_DEVMODE_CHROMIUM_EXECUTABLE;\nexport default {\n  ...config,\n  webServer: { ...config.webServer, cwd: process.cwd() },\n  testDir: '../..',\n  projects: [\n    {\n      ...config.projects[0],\n      use: { ...config.projects[0].use, launchOptions: { executablePath } },\n    },\n  ],\n};\n","exit_code":0,"status":"completed"}}
