ull));\n    }\n    return doc;\n  };\n  return {\n    get: (id) => load().byId.get(id),\n    roots: () => load().roots.map((node) => node.id),\n    children: (id) =>\n      (load().byId.get(id)?.children ?? []).map((node) => node.id),\n    parentOf: (id) => (load(), parents.get(id) ?? null),\n    toDocument: load,\n    subscribe: (listener) =>\n      config.subscribe((...args) => {\n        doc = null;\n        listener(...args);\n      }),\n  };\n}\n\n/** Adapt an existing ui-dom page without changing its edit or pick behavior. */\nexport function createUiDomAdapter(options) {\n  const { config, policy, root } = options;\n  const tree = options.store ?? documentTree(config);\n  const modelOptions = {\n    policy,\n    vocabulary: options.vocabulary ?? defaultVocabulary(),\n    parentOf: (id) => tree.parentOf(id),\n    getElement: (id) => tree.get(id),\n  };\n  const layer = policy.writeLayers.includes('session')\n    ? 'session'\n    : topWritableLayer(policy);\n  return {\n    tree: () => tree,\n    nodeFor: (id) =>\n      options.handle?.nodeFor?.(id) ??\n      [...root.querySelectorAll('[data-link-id]')].find(\n        (node) => node.getAttribute('data-link-id') === id\n      ) ??\n      null,\n    idFor(node) {\n      for (let at = node; at && root.contains(at); at = at.parentNode) {\n        if (at.nodeType === 1 && at.hasAttribute('data-link-id')) {\n          return at.getAttribute('data-link-id');\n        }\n      }\n      return null;\n    },\n    rows: (id) =>\n      tree.get(id) ? propertyRows(tree.get(id), config, modelOptions) : [],\n    applyProperty(id, row, value) {\n      if (typeof row === 'string') {\n        row = { name: row, key: null };\n      }\n      return applyEdit(\n        config,\n        { id, name: row.name, key: row.key ?? null, value, layer },\n        modelOptions\n      );\n    },\n    observe: (callback) => config.subscribe(callback),\n  };\n}\n/** Each delivery channel implements async getItem/setItem of LiNo text. */\nexport const storageKey = (location) =>\n  `link-ui-devmode:${location.origin}:${location.pathname}`;\nexport const localStorageAdapter = (storage) => ({\n  getItem: async (key) => await storage.getItem(key),\n  setItem: async (key, value) => await storage.setItem(key, value),\n});\nexport const chromeStorageAdapter = (storage) => ({\n  getItem: async (key) => (await storage.get(key))[key] ?? null,\n  setItem: async (key, value) => await storage.set({ [key]: value }),\n});\nexport async function loadOverrides(storage, location) {\n  return (await storage.getItem(storageKey(location))) ?? '';\n}\nexport async function saveOverrides(storage, location, overrides) {\n  await storage.setItem(storageKey(location), overrides);\n}\n---\n'@link-foundation/ui-devmode': minor\n'@link-foundation/ui-convert': minor\n'@link-foundation/ui-dom': patch\n---\n\nInspect and edit foreign DOM pages with persistent LiNo overrides, subtree export,\na configurable bookmarklet and a private Manifest V3 extension. Allow DOM imports\nto exclude inspector hosts before assigning structural IDs.\n","exit_code":0,"status":"completed"}}
