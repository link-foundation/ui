e').click();\n  await panel(page).getByRole('tab', { name: 'Properties', exact: true }).click();\n  await row(page, 'text').fill('Migrated card');\n  await row(page, 'style color').fill('#b3261e');\n  await expect(page.locator('#card-title')).toHaveText('Migrated card');\n  await expect(page.locator('#card-title')).toHaveCSS('color', 'rgb(179, 38, 30)');\n  await page.evaluate(() => globalThis.linkUiForeignDevMode.whenSaved());\n  const exported = await page.evaluate(() => ({ patch: globalThis.linkUiForeignDevMode.exportOverrides(), subtree: globalThis.linkUiForeignDevMode.exportSubtree() }));\n  expect(exported.patch.count).toBe(2);\n  expect(exported.subtree).toContain('Migrated card');\n  expect(exported.patch.links[0].values.filter((link) => Array.isArray(link) && link[0] === 'set')).toHaveLength(2);\n  await expectAccessible(page, { include: 'ui-foreign-devmode' });\n  if (process.env.UPDATE_DOCS_SCREENSHOTS === '1' && info.project.name === 'chromium') {\n    await mkdir('docs/screenshots', { recursive: true });\n    await page.screenshot({ path: 'docs/screenshots/ui-devmode-foreign.png' });\n  }\n  await page.reload();\n  await inject(page);\n  await expect(page.locator('#card-title')).toHaveText('Migrated card');\n  await expect(page.locator('#card-title')).toHaveCSS('color', 'rgb(179, 38, 30)');\n  await page.evaluate(() => {\n    globalThis.linkUiForeignDevMode.select('card-title');\n    const item = document.createElement('h2'); item.id = 'new-title'; item.textContent = 'New card'; document.querySelector('main').append(item);\n  });\n  await expect(panel(page).getByRole('treeitem').filter({ has: page.locator('[data-id=\\\"new-title\\\"]') })).toHaveCount(0); // IDs below verify refresh directly.\n  await expect.poll(() => page.evaluate(() => globalThis.linkUiForeignDevMode.adapter.nodeFor('new-title')?.textContent)).toBe('New card');\n  expect(await page.evaluate(() => globalThis.linkUiForeignDevMode.getSelection().id)).toBe('card-title');\n  await page.evaluate(() => { document.querySelector('#card-title').remove(); });\n  await expect.poll(() => page.evaluate(() => globalThis.linkUiForeignDevMode.getSelection())).toBe(null);\n  await page.addScriptTag({ path: BUNDLE });\n  await page.evaluate(() => globalThis.linkUiForeignReady);\n  await expect(panel(page)).toHaveCount(0);\n});\n\ntest('bookmarklet emits javascript URL and strict CSP blocks loader', async ({ page }) => {\n  const loader = await readFile('packages/ui-devmode/dist/bookmarklet.txt', 'utf8');\n  expect(loader.startsWith('javascript:')).toBe(true);\n  await page.goto(CSP);\n  const blocked = await page.evaluate(() => new Promise((resolve) => {\n    document.addEventListener('securitypolicyviolation', (event) => resolve(event.violatedDirective), { once: true });\n    const script = document.createElement('script'); script.type = 'module'; script.src = '/packages/ui-devmode/dist/foreign.js'; document.documentElement.append(script);\n  }));\n  expect(blocked).toContain('script-src');\n  await expect(panel(page)).toHaveCount(0);\n});\n\ntest('unpacked MV3 action edits and restores a strict CSP page in an isolated world', async ({}, info) => {\n  test.skip(info.project.name \"'!== '\"'chromium', 'Manifest V3 is a Chromium delivery channel');\n  const folder = await mkdtemp(path.join(tmpdir(), 'links-ui-extension-'));\n  const extension = path.join(folder, 'unpacked');\n  await cp('packages/ui-devmode-extension/dist/unpacked', extension, { recursive: true });\n  const manifest = JSON.parse(await readFile(path.join(extension, 'manifest.json'), 'utf8'));\n  // Automation cannot click browser chrome. Grant only the fixture origin in this\n  // temporary test copy, then dispatch the registered action listener in the worker.\n  manifest.host_permissions = ['http://127.0.0.1/*'];\n  await writeFile(path.join(extension, 'manifest.json'), JSON.stringify(manifest));\n  const context = await chromium.launchPersistentContext(path.join(folder, 'profile'), {\n    channel