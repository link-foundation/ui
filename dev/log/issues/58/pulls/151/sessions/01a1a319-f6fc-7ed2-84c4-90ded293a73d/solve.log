\n * @param {any} root\n * @param {{ comments?: boolean, location?: (node: any) => any }} options\n * @returns {import('./tree.js').HtmlNode[]}\n */\nexport function readDom(root, options) {\n  return readTree(domReader(options.location), root, options);\n}\n/**\n * HTML / DOM -> UI dialect of Links Notation.\n *\n * Both entry points read their input into the intermediate form\n * (`tree.js`), give every node a deterministic id (`ids.js`) and run the\n * same mapping step (`mapping.js`) that builds `Link` objects of\n * `links-notation`. The links are projected and formatted by\n * `@link-foundation/ui-core`, whose `format` writes every link with\n * `Link.format`; no Links Notation text is concatenated here.\n */\n\nimport { Link } from 'links-notation';\nimport {\n  SPEC_VERSION,\n  format,\n  projectLinks,\n  valueMatches,\n} from '@link-foundation/ui-core';\nimport { readHtml } from './from-html.js';\nimport { readDom } from './from-dom.js';\nimport { assignIds } from './ids.js';\nimport { HTML_FALLBACK_KIND, HTML_MAPPING, findRule } from './mapping.js';\nimport { DROPPED_TAGS, droppedScript, unsafeAttribute } from './security.js';\nimport { collapseCss, parseStyle, styleLink } from './style.js';\nimport { COMMENT, TEXT } from './tree.js';\nimport { htmlVocabulary } from './vocabulary.js';\n\nconst atom = (text) => new Link(text);\nconst property = (name, ...values) =>\n  new Link(null, [atom(name), ...values.map(atom)]);\n\nconst textOf = (node) =>\n  node.children\n    .filter((child) => child.tag === TEXT)\n    .map((child) => child.text)\n    .join('');\n\n/** A `<style>` child without attributes becomes `(raw-css ...)`. */\nconst isPlainStyle = (node) => node.tag === 'style' && node.attrs.length === 0;\n\n/** The text content when every child is text, otherwise `null`. */\nconst textContent = (children) =>\n  children.every((child) => child.tag === TEXT)\n    ? children\n        .map((child) => child.text)\n        .join('')\n        .trim()\n    : null;\n\nclass Importer {\n  constructor(roots, options) {\n    this.vocabulary = options.vocabulary ?? htmlVocabulary();\n    this.table = options.mapping ?? HTML_MAPPING;\n    this.ids = assignIds(roots);\n    /** Document order of every node, to report diagnostics in that order. */\n    this.order = new Map([...this.ids.keys()].map((node, i) => [node, i]));\n    this.keepNodes = Boolean(options.keepNodes);\n    this.diagnostics = [];\n    this.spans = new Map();\n    this.nodeMap = new Map();\n  }\n\n  /** Remove dropped elements, with one diagnostic each. */\n  safe(nodes) {\n    return nodes.filter((node) => {\n      if (!DROPPED_TAGS.includes(node.tag)) {\n        return true;\n      }\n      this.report(node, `the <${node.tag}> element`);\n      return false;\n    });\n  }\n\n  report(node, what) {\n    this.diagnostics.push({\n      order: this.order.get(node),\n      diagnostic: droppedScript(this.ids.get(node), what),\n    });\n  }\n\n  /** The attributes that stay, without the id the link already carries. */\n  safeAttrs(node, id) {\n    return node.attrs.filter(([name, value]) => {\n      const unsafe = unsafeAttribute(name, value);\n      if (unsafe) {\n        this.report(node, unsafe);\n        return false;\n      }\n      return !(name === 'id' && value === id);\n    });\n  }\n\n  remember(node, id) {\n    if (node.span) {\n      this.spans.set(id, node.span);\n    }\n    if (this.keepNodes && node.node !== undefined) {\n      this.nodeMap.set(id, node.node);\n    }\n  }\n\n  /**\n   * One node of the intermediate form as an element link.\n   * @param {import('./tree.js').HtmlNode} node\n   * @returns {Link}\n   */\n  link(node) {\n    const id = this.ids.get(node);\n    this.remember(node, id);\n    if (node.tag === TEXT || node.tag === COMMENT) {\n      const kind = node.tag === TEXT ? 'text' : 'comment';\n      return new Link(id, [atom(kind), atom(node.text)]);\n    }\n    const attrs = this.safeAttrs(node, id);\n    const inner = this.safe(node.children);\n    const styles = node.tag === 'style' ? [node] : inner.filter(isPlainStyle);\n    const children =\n      node.tag === 'style' ? [] : inner.filter((c) => !isPlainStyle(c));\n    const mapped = mapHtmlElement(\n      node,\n      children,\n      attrs,\n      this.vocabulary,\n      this.table\n    ) ?? {\n      head: [atom(HTML_FALLBACK_KIND), property('tag', node.tag)],\n      attrs,\n      children,\n    };\n    return new Link(id, [\n      ...mapped.head,\n      ...mapped.attrs.flatMap(([name, value]) =>\n        name === 'style'\n          ? []\n          : [\n              value === ''\n                ? property('attr', name)\n                : property('attr', name, value),\n            ]\n      ),\n      ...[styleLink(parseStyle(attrValue(attrs, 'style') ?? ''))].filter(\n        Boolean\n      ),\n      ...styles\n        .map((style) => collapseCss(textOf(style)))\n        .filter((css) => css !== '')\n        .map((css) => property('raw-css', css)),\n      ...mapped.children.map((child) => this.link(child)),\n    ]);\n  }\n\n  /** Convert the top-level nodes and format the result. */\n  run(roots, options) {\n    const links = this.safe(roots).map((node) => this.link(node));\n    const projected = projectLinks(links, this.vocabulary);\n    const tree = { spec: SPEC_VERSION, ...projected };\n    const text = format(tree, {\n      style: options.style,\n      indent: options.indent,\n    });\n    const result = {\n      text,\n      tree,\n      links,\n      spans: this.spans,\n      diagnostics: [\n        ...this.diagnostics\n          .sort((a, b) => a.order - b.order)\n          .map((entry) => entry.diagnostic),\n        ...projected.diagnostics,\n      ],\n    };\n    if (this.keepNodes) {\n      result.nodeMap = this.nodeMap;\n    }\n    return result;\n  }\n}\n\n/**\n * The head, remaining attributes and children of an element that a rule of\n * the mapping table maps to a dialect kind, or `null` (fallback).\n * @param {import('./tree.js').HtmlNode} node\n * @param {import('./tree.js').HtmlNode[]} children the children that stay\n * @param {[string, string][]} attrs the attributes that stay\n * @param {import('@link-foundation/ui-core').Vocabulary} vocabulary\n * @param {readonly import('./mapping.js').MappingRule[]} [table]\n * @returns {{ head: Link[], attrs: [string, string][],\n *   children: import('./tree.js').HtmlNode[] } | null}\n */\nexport function mapHtmlElement(\n  node,\n  children,\n  attrs,\n  vocabulary,\n  table = HTML_MAPPING\n) {\n  const rule = findRule(node, vocabulary, table);\n  if (!rule) {\n    return null;\n  }\n  const spec = vocabulary.kinds.get(rule.kind);\n  const text = rule.text ? textContent(children) : null;\n  if (spec.children === 'none' && children.length > 0 && text === null) {\n    return null;\n  }\n  const { head, consumed } = ruleHead(rule, spec, node, text, attrs);\n  return {\n    head,\n    attrs: attrs.filter(([name]) => !consumed.has(name)),\n    children: text === null ? children : [],\n  };\n}\n\n/**\n * The head of a mapped element: kind, text, the attributes the rule turns\n * into properties (when their value matches the property type), `tag` when\n * the element is not the tag the kind stands for, and the heading `level`.\n */\nfunction ruleHead(rule, spec, node, text, attrs) {\n  const head = [atom(rule.kind)];\n  if (text && rule.text === 'positional') {\n    head.push(atom(text));\n  } else if (text) {\n    head.push(property(rule.text, text));\n  }\n  const consumed = new Set();\n  for (const [name, target] of Object.entries(rule.attrs ?? {})) {\n    const value = attrValue(attrs, name);\n    const type = spec.properties.get(target)?.type;\n    if (value && type && valueMatches(type, value)) {\n      head.push(property(target, value));\n      consumed.add(name);\n    }\n  }\n  if (rule.tag !== node.tag) {\n    head.push(property('tag', node.tag));\n  }\n  if (rule.level) {\n    head.push(property('level', String(rule.level)));\n  }\n  return { head, consumed };\n}\n\nfunction attrValue(attrs, name) {\n  return attrs.find(([key]) => key === name)?.[1];\n}\n\n/**\n * Import an HTML string (Node.js, Bun, Deno and browsers).\n * @param {string} text\n * @param {import('../index.js').ImportOptions} [options]\n */\nexport function importHtml(text, options = {}) {\n  if (typeof text !== 'string') {\n    throw new TypeError('importHtml expects HTML text (a string)');\n  }\n  const roots = readHtml(text, options);\n  return new Importer(roots, options).run(roots, options);\n}\n\n/**\n * Import a live DOM subtree (browsers and jsdom). The result also has\n * `nodeMap`: link id -> the original DOM `Node`.\n * @param {any} root a `Node`: an element, a document or a fragment\n * @param {import('../index.js').ImportDomOptions} [options]\n */\nexport function importDom(root, options = {}) {\n  if (!root || typeof root.nodeType !== 'number') {\n    throw new TypeError('importDom expects a DOM Node');\n  }\n  const roots = readDom(root, options);\n  return new Importer(roots, { ...options, keepNodes: true }).run(\n    roots,\n    options\n  );\n}\n/**\n * Link ids of imported elements. The same input always gives the same ids:\n *\n * - an element's `id` attribute is used when it is a valid Links Notation\n *   reference (written without quotes) and the first one with that value;\n * - every other node gets a path id from its tag and the indices from the\n *   root (`div-0-2-1`: the second child of the third child of the first\n *   top-level node);\n * - an id that is already taken gets the first free suffix `-2`, `-3`, ...\n */\n\nimport { escapeReference } from 'links-notation';\nimport { COMMENT, TEXT } from './tree.js';\n\n/**\n * Whether `value` can be a link id as it is: a non-empty reference that\n * needs no quotes and does not start with a reserved sigil (`@`, `$`).\n * @param {string | undefined} value\n */\nexport const isValidId = (value) =>\n  typeof value === 'string' &&\n  value !== '' &&\n  escapeReference(value) === value &&\n  !value.startsWith('@') &&\n  !value.startsWith('$');\n\n/** The value of attribute `name`, or `undefined`. */\nexport const attrValue = (node, name) =>\n  node.attrs.find(([key]) => key === name)?.[1];\n\nconst ID_TAGS = { [TEXT]: 'text', [COMMENT]: 'comment' };\n\n/** The tag part of a path id. */\nfunction idTag(node) {\n  const tag = ID_TAGS[node.tag] ?? node.tag;\n  return isValidId(tag) ? tag : 'element';\n}\n\nfunction walk(nodes, path, visit) {\n  nodes.forEach((node, index) => {\n    const here = [...path, index];\n    visit(node, here);\n    walk(node.children, here, visit);\n  });\n}\n\n/**\n * Assign a unique link id to every node of the intermediate tree, in\n * document order.\n * @param {import('./tree.js').HtmlNode[]} roots\n * @returns {Map<import('./tree.js').HtmlNode, string>}\n */\nexport function assignIds(roots) {\n  const taken = new Set();\n  walk(roots, [], (node) => {\n    const id = attrValue(node, 'id');\n    if (isValidId(id)) {\n      taken.add(id);\n    }\n  });\n  const used = new Set();\n  const ids = new Map();\n  walk(roots, [], (node, path) => {\n    const own = attrValue(node, 'id');\n    if (isValidId(own) && !used.has(own)) {\n      used.add(own);\n      ids.set(node, own);\n      return;\n    }\n    const base = isValidId(own) ? own : `${idTag(node)}-${path.join('-')}`;\n    let id = base;\n    for (let n = 2; taken.has(id); n++) {\n      id = `${base}-${n}`;\n    }\n    taken.add(id);\n    used.add(id);\n    ids.set(node, id);\n  });\n  return ids;\n}\n/**\n * The intermediate form shared by every HTML reader: both `importHtml`\n * (HTML text) and `importDom` (a live DOM) produce this tree, and one mapping\n * step (`import.js`) turns it into dialect elements.\n *\n * @typedef {{ start: number, end: number }} Span\n * @typedef {{\n *   tag: string,\n *   attrs: [string, string][],\n *   children: HtmlNode[],\n *   text?: string,\n *   span?: Span,\n *   node?: unknown,\n * }} HtmlNode\n *\n * `tag` is the lower-case element name, `#text` for text and `#comment` for\n * comments (which also carry `text`). `node` is the source node the reader\n * walked (a DOM `Node` or a parse5 node).\n *\n * A reader is an adapter over its own node type:\n *\n * @typedef {{\n *   type(node: any): 'element' | 'text' | 'comment' | 'container' | 'other',\n *   tag(node: any): string,\n *   attrs(node: any): [string, string][],\n *   text(node: any): string,\n *   children(node: any): any[],\n *   span(node: any): Span | undefined,\n * }} Reader\n */\n\nexport const TEXT = '#text';\nexport const COMMENT = '#comment';\n\n/** Elements whose text keeps its whitespace. */\nconst PRESERVE = new Set(['pre', 'textarea', 'listing', 'plaintext', 'style']);\n\nconst isHtmlSpace = (c) =>\n  c === ' ' || c === '\\t' || c === '\\n' || c === '\\f' || c === '\\r';\n\n/**\n * Replace every run of HTML whitespace with one space. A character scanner,\n * no regular expressions.\n * @param {string} text\n */\nexport function collapseSpace(text) {\n  let out = '';\n  let space = false;\n  for (const c of text) {\n    if (isHtmlSpace(c)) {\n      space = true;\n    } else {\n      out += space ? ` ${c}` : c;\n      space = false;\n    }\n  }\n  return space ? `${out} ` : out;\n}\n\nfunction trimEnds(children) {\n  const first = children[0];\n  if (first?.tag === TEXT) {\n    first.text = first.text.trimStart();\n  }\n  const last = children[children.length - 1];\n  if (last?.tag === TEXT) {\n    last.text = last.text.trimEnd();\n  }\n  return children.filter((child) => child.tag !== TEXT || child.text !== '');\n}\n\n/**\n * Read one source node into the intermediate form, or `null` when it is not\n * kept (doctype, whitespace-only text, comment without `options.comments`).\n */\nfunction readNode(reader, node, preserve, options) {\n  const type = reader.type(node);\n  const span = reader.span(node);\n  const at = (value) => (span ? { ...value, span, node } : { ...value, node });\n  if (type === 'text') {\n    const raw = reader.text(node);\n    const text = preserve ? raw : collapseSpace(raw);\n    return text.trim() === '' && !preserve\n      ? null\n      : at({ tag: TEXT, attrs: [], children: [], text });\n  }\n  if (type === 'comment') {\n    return options.comments\n      ? at({ tag: COMMENT, attrs: [], children: [], text: reader.text(node) })\n      : null;\n  }\n  if (type !== 'element') {\n    return null;\n  }\n  const tag = reader.tag(node);\n  const inner = preserve || PRESERVE.has(tag);\n  return at({\n    tag,\n    attrs: reader.attrs(node),\n    children: readChildren(reader, reader.children(node), inner, options),\n  });\n}\n\nfunction readChildren(reader, nodes, preserve, options) {\n  const children = [];\n  for (const child of nodes) {\n    const read = readNode(reader, child, preserve, options);\n    if (read) {\n      children.push(read);\n    }\n  }\n  return preserve ? children : trimEnds(children);\n}\n\n/**\n * Read a source root into the top-level intermediate nodes. A container\n * (document or fragment) gives its children; anything else gives itself.\n * @param {Reader} reader\n * @param {any} root\n * @param {{ comments?: boolean }} options\n * @returns {HtmlNode[]}\n */\nexport function readTree(reader, root, options) {\n  const nodes =\n    reader.type(root) === 'container' ? reader.children(root) : [root];\n  return readChildren(reader, nodes, false, options);\n}\n{\n  \"name\": \"@link-foundation/ui-devmode\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Development/configuration mode of the associative UI framework: a runtime inspector overlay over any page rendered by ui-dom, to hover, select, inspect and edit every element, writing only to the session and user configuration layers\",\n  \"type\": \"module\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./src/index.d.ts\",\n      \"default\": \"./src/index.js\"\n    },\n    \"./model\": {\n      \"types\": \"./src/model.d.ts\",\n      \"default\": \"./src/model.js\"\n    },\n    \"./agent-instruction\": {\n      \"types\": \"./src/agent-instruction.d.ts\",\n      \"default\": \"./src/agent-instruction.js\"\n    }\n  },\n  \"types\": \"./src/index.d.ts\",\n  \"files\": [\n    \"src/\",\n    \"README.md\",\n    \"LICENSE\"\n  ],\n  \"keywords\": [\n    \"ui\",\n    \"links-notation\",\n    \"devtools\",\n    \"inspector\",\n    \"configuration\"\n  ],\n  \"license\": \"Unlicense\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/link-foundation/ui.git\",\n    \"directory\": \"packages/ui-devmode\"\n  },\n  \"homepage\": \"https://github.com/link-foundation/ui/tree/main/packages/ui-devmode#readme\",\n  \"bugs\": {\n    \"url\": \"https://github.com/link-foundation/ui/issues\"\n  },\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"dependencies\": {\n    \"@link-foundation/ui-config\": \"^0.0.0\",\n    \"@link-foundation/ui-core\": \"^0.0.0\",\n    \"@link-foundation/ui-dom\": \"^0.0.0\",\n    \"@link-foundation/ui-style\": \"^0.0.0\",\n    \"@link-foundation/ui-tokens\": \"^0.0.0\"\n  },\n  \"devDependencies\": {\n    \"@link-foundation/ui-store\": \"^0.0.0\",\n    \"jsdom\": \"^30.1.3\",\n    \"test-anywhere\": \"^0.8.48\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  }\n}\n{\n  \"name\": \"@link-foundation/ui-convert\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Converters between the UI dialect of Links Notation and other UI formats: HTML/DOM, JSX/TSX (MUI) and Vue SFC import, A2UI, Adaptive Cards, JSON Forms and Lottie\",\n  \"type\": \"module\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./src/index.d.ts\",\n      \"default\": \"./src/index.js\"\n    },\n    \"./interop\": \"./src/interop/index.js\"\n  },\n  \"types\": \"./src/index.d.ts\",\n  \"bin\": {\n    \"ui-convert\": \"./src/cli.js\"\n  },\n  \"files\": [\n    \"src/\",\n    \"README.md\",\n    \"LICENSE\"\n  ],\n  \"keywords\": [\n    \"ui\",\n    \"links-notation\",\n    \"html\",\n    \"dom\",\n    \"importer\",\n    \"jsx\",\n    \"tsx\",\n    \"mui\",\n    \"vue\",\n    \"a2ui\",\n    \"adaptive-cards\",\n    \"json-forms\",\n    \"lottie\"\n  ],\n  \"license\": \"Unlicense\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/link-foundation/ui.git\",\n    \"directory\": \"packages/ui-convert\"\n  },\n  \"homepage\": \"https://github.com/link-foundation/ui/tree/main/packages/ui-convert#readme\",\n  \"bugs\": {\n    \"url\": \"https://github.com/link-foundation/ui/issues\"\n  },\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"dependencies\": {\n    \"@babel/parser\": \"^7.29.12\",\n    \"@link-foundation/ui-core\": \"^0.0.0\",\n    \"@vue/compiler-dom\": \"^3.5.44\",\n    \"links-notation\": \"^0.27.1\",\n    \"parse5\": \"^8.0.1\"\n  },\n  \"devDependencies\": {\n    \"@lottie-animation-community/lottie-specs\": \"^0.3.2\",\n    \"ajv\": \"^8.17.1\",\n    \"jsdom\": \"^30.1.3\",\n    \"lottie-web\": \"^5.13.0\",\n    \"test-anywhere\": \"^0.8.48\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  }\n}\n/**\n * Shared Playwright Test configuration for visual regression and\n * accessibility tests. See docs/testing-ui.md.\n *\n * Test files use the `.e2e.mjs` suffix so `node --test`, `bun test` and\n * `deno test` never pick them up. Cross-package browser tests live in\n * `tests/e2e/*.spec.js`, a package's own browser tests in\n * `packages/<pkg>/tests/e2e/*.spec.js`; bunfig.toml keeps them out of\n * `bun test`.\n */\nimport { defineConfig, devices } from '@playwright/test';\n\nconst PORT = 4173;\nconst BASE_URL = `http://127.0.0.1:${PORT}/`;\n\nexport default defineConfig({\n  testDir: '.',\n  testMatch: [\n    'tests/ui/**/*.e2e.mjs',\n    'packages/*/e2e/**/*.e2e.mjs',\n    'tests/e2e/**/*.spec.js',\n    'packages/*/tests/e2e/**/*.spec.js',\n  ],\n  testIgnore: ['**/node_modules/**'],\n  // Baselines live next to the tests that own them:\n  //   tests/ui/__screenshots__/<project>/<file>/<name>.png\n  //   packages/<pkg>/e2e/__screenshots__/<project>/<file>/<name>.png\n  snapshotPathTemplate:\n    '{testFileDir}/__screenshots__/{projectName}/{testFileName}/{arg}{ext}',\n  outputDir: 'test-results',\n  fullyParallel: true,\n  forbidOnly: Boolean(process.env.CI),\n  retries: process.env.CI ? 1 : 0,\n  timeout: 30_000,\n  reporter: [['list'], ['html', { open: 'never' }]],\n  expect: {\n    timeout: 5_000,\n    toHaveScreenshot: {\n      maxDiffPixelRatio: 0.001,\n      // Per-pixel colour tolerance (pixelmatch YIQ). The default 0.2 lets a\n      // hue change of similar brightness pass; baselines come from one pinned\n      // container, so a strict value stays stable.\n      threshold: 0.05,\n      animations: 'disabled',\n      caret: 'hide',\n    },\n  },\n  use: {\n    baseURL: BASE_URL,\n    viewport: { width: 1280, height: 800 },\n    deviceScaleFactor: 1,\n    locale: 'en-US',\n    timezoneId: 'UTC',\n    colorScheme: 'light',\n    reducedMotion: 'reduce',\n    trace: 'retain-on-failure',\n  },\n  projects: [\n    {\n      name: 'chromium',\n      use: {\n        ...devices['Desktop Chrome'],\n        viewport: { width: 1280, height: 800 },\n        deviceScaleFactor: 1,\n      },\n    },\n    {\n      name: 'webkit',\n      use: {\n        ...devices['Desktop Safari'],\n        viewport: { width: 1280, height: 800 },\n        deviceScaleFactor: 1,\n      },\n    },\n  ],\n  webServer: {\n    command: `node scripts/serve-static.mjs --port ${PORT}`,\n    url: `${BASE_URL}tests/ui/pages/smoke.html`,\n    reuseExistingServer: !process.env.CI,\n    timeout: 30_000,\n  },\n});\nname: UI tests\n\n# Visual regression (toHaveScreenshot) and WCAG 2.2 A/AA (axe-core) tests.\n# See docs/testing-ui.md. Issue: #13.\non:\n  pull_request:\n  push:\n    branches: [main]\n  workflow_dispatch:\n    inputs:\n      update-snapshots:\n        description: Regenerate screenshot baselines and upload them as an artifact\n        type: boolean\n        default: false\n\npermissions:\n  contents: read\n\njobs:\n  ui-tests:\n    name: UI tests (Playwright + axe)\n    runs-on: ubuntu-24.04\n    container:\n      # Same image digest as preview-regen in example-app.yml. Keep the tag\n      # comment equal to the @playwright/test pin in package.json\n      # (scripts/check-playwright-version.mjs enforces it).\n      image: mcr.microsoft.com/playwright@sha256:b0ab6f3cb99aa7803adbc14d9027ec1785fc6e433b97e134e0f8fe61683b6b53 # v1.59.1-noble\n    timeout-minutes: 20\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-ui-tests\n      cancel-in-progress: true\n    env:\n      PLAYWRIGHT_BROWSERS_PATH: /ms-playwright\n      PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: '1'\n      UPDATE_SNAPSHOTS: ${{ github.event_name == 'workflow_dispatch' && inputs.update-snapshots }}\n    # Container jobs run `run:` blocks with sh, which has no [[ ]].\n    defaults:\n      run:\n        shell: bash\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        with:\n          persist-credentials: false\n\n      # The container user (root) does not own the runner's workspace.\n      - name: Trust the checkout\n        run: git config --global --add safe.directory \"$GITHUB_WORKSPACE\"\n\n      - name: Check Playwright version pins\n        run: node scripts/check-playwright-version.mjs\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      - name: Install example app dependencies\n        run: npm ci --prefix examples/universal-app --no-audit --no-fund\n\n      - name: Build example app\n        run: npm run example:web:build\n\n      # The icon gallery loads the generated sets from the gitignored dist/.\n      - name: Build icon sets\n        run: npm run build:icons\n\n      - name: Install Expo example dependencies\n        run: npm ci --prefix examples/react-native --no-audit --no-fund\n\n      - name: Export Expo example through React Native Web\n        run: npm --prefix examples/react-native run build\n\n      - name: Test native web keyboard actions and accessibility\n        run: npx playwright test --config examples/react-native/playwright.config.mjs\n\n      - name: Run Playwright tests\n        if: env.UPDATE_SNAPSHOTS != 'true'\n        run: npx playwright test\n\n      - name: Update screenshot baselines\n        if: env.UPDATE_SNAPSHOTS == 'true'\n        run: npx playwright test --update-snapshots\n\n      - name: Retain network performance traces\n        if: always()\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: network-performance-${{ github.run_id }}-${{ github.run_attempt }}\n          path: |\n            test-results/**/trace.zip\n            test-results/**/attachments/canvas-pan-performance*\n          retention-days: 7\n          if-no-files-found: error\n\n      - name: Upload test report and diffs\n        if: failure()\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: ui-tests-failure-${{ github.run_id }}-${{ github.run_attempt }}\n          path: |\n            playwright-report/\n            test-results/\n            examples/react-native/test-results/\n          retention-days: 7\n          if-no-files-found: error\n\n      # A human downloads this artifact and commits it; the job never pushes.\n      - name: Upload updated baselines\n        if: env.UPDATE_SNAPSHOTS == 'true'\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: ui-screenshots-${{ github.run_id }}\n          path: |\n            tests/ui/__screenshots__/**\n            tests/e2e/__screenshots__/**\n            packages/*/e2e/__screenshots__/**\n            packages/*/tests/e2e/__screenshots__/**\n          retention-days: 7\n          if-no-files-found: error\n/**\n * Dev mode in a real browser: the example page renders the issue-1 sample\n * with ui-dom and mounts dev mode with the site policy of the issue.\n *\n * `UPDATE_DOCS_SCREENSHOTS=1` also writes the inspector screenshot of the\n * documentation (docs/screenshots/ui-devmode-inspector.png).\n */\nimport { mkdirSync } from 'node:fs';\nimport { test, expect } from '@playwright/test';\nimport { expectAccessible } from '../../../tests/ui/helpers.mjs';\n\nconst PAGE = 'packages/ui-devmode/examples/';\nconst LAZY_MODULES = [\n  'session.js',\n  'inspector.js',\n  'overlay.js',\n  'model.js',\n  'views.js',\n  'editors.js',\n];\n\n/**\n * Wait for the first render and, when `?ui-dev` opens dev mode, for its\n * global handle: the inspector is loaded with a dynamic `import()` after the\n * page is ready.\n */\nasync function waitForPage(page, query) {\n  await page.waitForSelector('#app[data-ready=\"true\"]');\n  if (query.includes('ui-dev') && !query.includes('policy=disabled')) {\n    await page.waitForFunction(() => 'linkUiDevMode' in globalThis);\n  }\n}\n\n/** Open the example and wait for the first render. */\nasync function openExample(page, query = '') {\n  const errors = [];\n  page.on('pageerror', (error) => errors.push(error.message));\n  await page.goto(`${PAGE}${query}`);\n  await waitForPage(page, query);\n  return errors;\n}\n\nconst inspector = (page) => page.locator('ui-devmode-inspector');\nconst isOpen = (page) => page.evaluate(() => 'linkUiDevMode' in globalThis);\nconst okButton = (page) => page.locator('#app [data-link-id=\"ok\"] button');\nconst row = (page, name) => inspector(page).locator(`tr[data-name=\"${name}\"]`);\nconst selection = (page) =>\n  page.evaluate(() => globalThis.linkUiDevMode.getSelection());\n\ntest.beforeEach(async ({ page }) => {\n  // Each test starts without saved changes.\n  await page.addInitScript(() => {\n    if (!globalThis.sessionStorage.getItem('devmode-e2e')) {\n      globalThis.sessionStorage.setItem('devmode-e2e', '1');\n      globalThis.localStorage.clear();\n    }\n  });\n});\n\ntest('?ui-dev opens dev mode and Alt+Shift+D toggles it', async ({ page }) => {\n  const errors = await openExample(page, '?ui-dev');\n  await expect(inspector(page).getByRole('complementary')).toBeVisible();\n  expect(await isOpen(page)).toBe(true);\n  await page.keyboard.press('Alt+Shift+KeyD');\n  await expect(inspector(page)).toHaveCount(0);\n  expect(await isOpen(page)).toBe(false);\n  await page.keyboard.press('Alt+Shift+KeyD');\n  await expect(inspector(page).getByRole('complementary')).toBeVisible();\n  expect(errors).toEqual([]);\n});\n\ntest('the shortcut does nothing in a text input', async ({ page }) => {\n  await openExample(page);\n  await page.locator('#notes').focus();\n  await page.keyboard.press('Alt+Shift+KeyD');\n  await page.waitForTimeout(200);\n  await expect(inspector(page)).toHaveCount(0);\n  await page.locator('h1').click();\n  await page.keyboard.press('Alt+Shift+KeyD');\n  await expect(inspector(page).getByRole('complementary')).toBeVisible();\n});\n\ntest('a disabled policy never requests the inspector modules', async ({\n  page,\n}) => {\n  const requested = [];\n  page.on('request', (request) => requested.push(request.url()));\n  await openExample(page, '?ui-dev&policy=disabled');\n  await page.locator('h1').click();\n  await page.keyboard.press('Alt+Shift+KeyD');\n  await page.waitForTimeout(300);\n  await expect(inspector(page)).toHaveCount(0);\n  expect(await isOpen(page)).toBe(false);\n  const devmode = requested\n    .filter((url) => url.includes('/packages/ui-devmode/src/'))\n    .map((url) => url.split('/').at(-1));\n  expect(devmode.includes('index.js')).toBe(true);\n  for (const name of LAZY_MODULES) {\n    expect(devmode).not.toContain(name);\n  }\n  expect(devmode.some((url) => url.endsWith('.lino'))).toBe(false);\n});\n\ntest('hover labels ok and a click selects it without the press', async ({\n  page,\n}) => {\n  const errors = await openExample(page, '?ui-dev');\n  await okButton(page).hover();\n  const hover = page.locator('ui-devmode-overlay [data-box=\"hover\"]');\n  await expect(hover).toBeVisible();\n  await expect(hover.locator('.label')).toHaveText('ok: button');\n  const pointer = await hover.evaluate(\n    (box) => globalThis.getComputedStyle(box).pointerEvents\n  );\n  expect(pointer).toBe('none');\n  await okButton(page).click();\n  expect(await selection(page)).toEqual({ id: 'ok', type: 'button' });\n  await expect(page.locator('#action')).toHaveText('none');\n  await expect(\n    page.locator('ui-devmode-overlay [data-box=\"selected\"] .label')\n  ).toHaveText('ok: button');\n  // Escape leaves pick mode: the app gets its press again.\n  await page.keyboard.press('Escape');\n  expect(await isOpen(page)).toBe(true);\n  await okButton(page).click();\n  await expect(page.locator('#action')).toHaveText(\n    'ok press → (navigate home)'\n  );\n  // A second Escape closes.\n  await page.keyboard.press('Escape');\n  await expect(inspector(page)).toHaveCount(0);\n  expect(errors).toEqual([]);\n});\n\ntest('the outline shows app > body > greeting, ok and selects', async ({\n  page,\n}) => {\n  await openExample(page, '?ui-dev');\n  const tree = inspector(page).getByRole('tree');\n  const items = tree.getByRole('treeitem');\n  await expect(items).toHaveCount(4);\n  const ids = await items.evaluateAll((nodes) =>\n    nodes.map((n) => `${n.getAttribute('aria-level')}:${n.dataset.id}`)\n  );\n  expect(ids).toEqual(['1:app', '2:body', '3:greeting', '3:ok']);\n  await tree.locator('[data-id=\"greeting\"] > .row').click();\n  expect(await selection(page)).toEqual({ id: 'greeting', type: 'text' });\n  await expect(tree.locator('[data-id=\"greeting\"]')).toHaveAttribute(\n    'aria-selected',\n    'true'\n  );\n  // Keyboard: the selection follows the focus.\n  await page.keyboard.press('ArrowDown');\n  expect(await selection(page)).toEqual({ id: 'ok', type: 'button' });\n  await page.keyboard.press('Home');\n  expect(await selection(page)).toEqual({ id: 'app', type: 'document' });\n  await okButton(page).click();\n  await expect(tree.locator('[data-id=\"ok\"]')).toHaveAttribute(\n    'aria-selected',\n    'true'\n  );\n});\n\ntest('a label edit is live, saved to user, kept on reload and reset to site', async ({\n  page,\n}) => {\n  await openExample(page, '?ui-dev');\n  await okButton(page).click();\n  await inspector(page).getByRole('tab', { name: 'Properties' }).click();\n  const label = row(page, 'label');\n  await expect(label).toHaveAttribute('data-layer', 'site');\n  await label.getByRole('textbox', { name: 'label' }).fill('Okay');\n  await expect(okButton(page)).toHaveText('Okay');\n  await expect(label).toHaveAttribute('data-layer', 'session');\n  await expect(label).toHaveClass(/is-changed/);\n\n  await inspector(page).getByRole('button', { name: 'Save' }).click();\n  await expect(label).toHaveAttribute('data-layer', 'user');\n\n  await page.reload();\n  await waitForPage(page, '?ui-dev');\n  await expect(okButton(page)).toHaveText('Okay');\n  await page.evaluate(() => globalThis.linkUiDevMode.select('ok'));\n  await inspector(page).getByRole('tab', { name: 'Properties' }).click();\n  await expect(label).toHaveAttribute('data-layer', 'user');\n\n  await label.getByRole('button', { name: 'Reset label' }).click();\n  await expect(label).toHaveAttribute('data-layer', 'site');\n  await expect(okButton(page)).toHaveText('OK');\n  await expect(label).not.toHaveClass(/is-changed/);\n});\n\ntest('setProperty applies to the session; locked elements are read-only', async ({\n  page,\n}) => {\n  await openExample(page, '?ui-dev&lock=body');\n  await page.evaluate(() => globalThis.linkUiDevMode.select('ok'));\n  await inspector(page).getByRole('tab', { name: 'Properties' }).click();\n  const label = row(page, 'label');\n  await expect(label).toHaveClass(/is-locked/);\n  await expect(label.getByRole('textbox', { name: 'label' })).toBeDisabled();\n  const error = await page.evaluate(() => {\n    try {\n      globalThis.linkUiDevMode.setProperty('ok', 'label', 'X');\n      return null;\n    } catch (e) {\n      return e.code;\n    }\n  });\n  expect(error).toBe('locked-element');\n  const layer = await page.evaluate(\n    () => globalThis.linkUiDevMode.setProperty('app', 'title', 'Edited').layer\n  );\n  expect(layer).toBe('session');\n});\n\ntest('the inspector passes axe and is keyboard-usable', async ({ page }) => {\n  await openExample(page, '?ui-dev');\n  await okButton(page).click();\n  await page.keyboard.press('Escape');\n  const tabs = inspector(page).getByRole('tab');\n  for (const name of [\n    'Outline',\n    'Properties',\n    'Styles',\n    'Tokens',\n    'Animations',\n    'Source',\n  ]) {\n    await tabs.filter({ hasText: name }).click();\n    await expectAccessible(page, { include: 'ui-devmode-inspector' });\n  }\n  // The dark colour scheme keeps the contrast.\n  await page.emulateMedia({ colorScheme: 'dark' });\n  for (const name of ['Outline', 'Properties']) {\n    await tabs.filter({ hasText: name }).click();\n    await expectAccessible(page, { include: 'ui-devmode-inspector' });\n  }\n  await page.emulateMedia({ colorScheme: 'light' });\n  // The tabs follow the arrow keys.\n  await tabs.filter({ hasText: 'Outline' }).focus();\n  await page.keyboard.press('ArrowRight');\n  await expect(tabs.filter({ hasText: 'Properties' })).toBeFocused();\n  await expect(tabs.filter({ hasText: 'Properties' })).toHaveAttribute(\n    'aria-selected',\n    'true'\n  );\n  // Tab moves from the selected tab into its panel, then its editors.\n  await page.keyboard.press('Tab');\n  await expect(inspector(page).getByRole('tabpanel')).toBeFocused();\n  await page.keyboard.press('Tab');\n  await expect(\n    row(page, 'label').getByRole('textbox', { name: 'label' })\n  ).toBeFocused();\n  await page.keyboard.press('End');\n  await page.keyboard.type('!');\n  await expect(okButton(page)).toHaveText('OK!');\n  // The toolbar works from the keyboard; Escape closes from inside.\n  const pick = inspector(page).getByRole('button', { name: 'Pick element' });\n  await pick.focus();\n  await page.keyboard.press('Shift+Tab');\n  await expect(pick).not.toBeFocused();\n  await page.keyboard.press('Tab');\n  await expect(pick).toBeFocused();\n  await page.keyboard.press('Enter');\n  await expect(pick).toHaveAttribute('aria-pressed', 'true');\n  await inspector(page).getByRole('button', { name: 'Discard' }).focus();\n  await page.keyboard.press('Enter');\n  await expect(okButton(page)).toHaveText('OK');\n  await page.keyboard.press('Escape');\n  await page.keyboard.press('Escape');\n  await expect(inspector(page)).toHaveCount(0);\n});\n\ntest('screenshot of the inspector with ok selected', async ({\n  page,\n}, testInfo) => {\n  await openExample(page, '?ui-dev');\n  await okButton(page).click();\n  await inspector(page).getByRole('tab', { name: 'Properties' }).click();\n  await row(page, 'label').getByRole('textbox', { name: 'label' }).fill('Okay');\n  await expect(row(page, 'label')).toHaveAttribute('data-layer', 'session');\n  await okButton(page).hover();\n  const shot = await page.screenshot();\n  await testInfo.attach('inspector', { body: shot, contentType: 'image/png' });\n  if (\n    process.env.UPDATE_DOCS_SCREENSHOTS === '1' &&\n    testInfo.project.name === 'chromium'\n  ) {\n    mkdirSync('docs/screenshots', { recursive: true });\n    await page.screenshot({\n      path: 'docs/screenshots/ui-devmode-inspector.png',\n    });\n    await page.emulateMedia({ colorScheme: 'dark' });\n    await page.screenshot({\n      path: 'docs/screenshots/ui-devmode-inspector-dark.png',\n    });\n  }\n});\n","exit_code":0,"status":"completed"}}
