pace ? ` ${c}` : c;\n      space = false;\n    }\n  }\n  return space ? `${out} ` : out;\n}\n\nfunction trimEnds(children) {\n  const first = children[0];\n  if (first?.tag === TEXT) {\n    first.text = first.text.trimStart();\n  }\n  const last = children[children.length - 1];\n  if (last?.tag === TEXT) {\n    last.text = last.text.trimEnd();\n  }\n  return children.filter((child) => child.tag !== TEXT || child.text !== '');\n}\n\n/**\n * Read one source node into the intermediate form, or `null` when it is not\n * kept (doctype, whitespace-only text, comment without `options.comments`).\n */\nfunction readNode(reader, node, preserve, options) {\n  const type = reader.type(node);\n  const span = reader.span(node);\n  const at = (value) => (span ? { ...value, span, node } : { ...value, node });\n  if (type === 'text') {\n    const raw = reader.text(node);\n    const text = preserve ? raw : collapseSpace(raw);\n    return text.trim() === '' && !preserve\n      ? null\n      : at({ tag: TEXT, attrs: [], children: [], text });\n  }\n  if (type === 'comment') {\n    return options.comments\n      ? at({ tag: COMMENT, attrs: [], children: [], text: reader.text(node) })\n      : null;\n  }\n  if (type !== 'element') {\n    return null;\n  }\n  const tag = reader.tag(node);\n  const inner = preserve || PRESERVE.has(tag);\n  return at({\n    tag,\n    attrs: reader.attrs(node),\n    children: readChildren(reader, reader.children(node), inner, options),\n  });\n}\n\nfunction readChildren(reader, nodes, preserve, options) {\n  const children = [];\n  for (const child of nodes) {\n    const read = readNode(reader, child, preserve, options);\n    if (read) {\n      children.push(read);\n    }\n  }\n  return preserve ? children : trimEnds(children);\n}\n\n/**\n * Read a source root into the top-level intermediate nodes. A container\n * (document or fragment) gives its children; anything else gives itself.\n * @param {Reader} reader\n * @param {any} root\n * @param {{ comments?: boolean }} options\n * @returns {HtmlNode[]}\n */\nexport function readTree(reader, root, options) {\n  const nodes =\n    reader.type(root) === 'container' ? reader.children(root) : [root];\n  return readChildren(reader, nodes, false, options);\n}\nimport { formatLinks, parseLinks } from '@link-foundation/ui-core';\nimport { readPatch } from '@link-foundation/ui-config';\n\n/** Export only writable-layer changes relative to site, in stable ID/property order. */\nexport function exportOverrides(\n  config,\n  { id = 'user-overrides', base, layers = ['user', 'session'] } = {}\n) {\n  if (layers.some((layer) => !['user', 'session'].includes(layer))) {\n    throw new Error('Only user and session overrides can be exported');\n  }\n  const exported = config.exportPatch({ layers, against: 'site', base });\n  const patch = readPatch(exported, {\n    maxSize: exported.length * 3,\n    maxOps: Number.MAX_SAFE_INTEGER,\n  });\n  if (patch.diagnostics.some((d) => d.severity === 'error')) {\n    throw new Error(patch.diagnostics.map((d) => d.message).join('; '));\n  }\n  const compare = (a, b) => (a < b ? -1 : a > b ? 1 : 0);\n  patch.ops.sort(\n    (a, b) =>\n      compare(a.id, b.id) ||\n      compare(a.name, b.name) ||\n      compare(a.key ?? '', b.key ?? '')\n  );\n  const links = [\n    {\n      id,\n      values: [\n        'overrides',\n        ['layer', 'user'],\n        ...(patch.base ? [['base', patch.base]] : []),\n        ...patch.ops.map((op) => [\n          'set',\n          op.id,\n          op.name,\n          ...(op.key === null ? [] : [op.key]),\n          ...op.values,\n        ]),\n      ],\n    },\n  ];\n  const text = formatLinks(links);\n  return {\n    text,\n    links: parseLinks(text, { maxInputSize: text.length }),\n    count: patch.ops.length,\n  };\n}\n  }\n  return response.text();\n}\n\n/** Make the tab buttons of the panels and wire the WAI-ARIA tabs keys. */\nfunction buildTabs(shadow, onChange) {\n  const list = shadow.querySelector('[role=\"tablist\"]');\n  const panels = [...shadow.querySelectorAll('[role=\"tabpanel\"]')];\n  const doc = shadow.ownerDocument;\n  const tabs = panels.map((panel) => {\n    const view = panel.dataset.view;\n    const tab = doc.createElement('button');\n    tab.type = 'button';\n    tab.setAttribute('role', 'tab');\n    tab.id = `devmode-tab-${view}`;\n    tab.dataset.view = view;\n    tab.textContent = panel.dataset.label;\n    panel.id = `devmode-panel-${view}`;\n    tab.setAttribute('aria-controls', panel.id);\n    panel.setAttribute('aria-labelledby', tab.id);\n    list.append(tab);\n    return tab;\n  });\n  const select = (view, focus = false) => {\n    tabs.forEach((tab, i) => {\n      const on = tab.dataset.view === view;\n      tab.setAttribute('aria-selected', String(on));\n      tab.tabIndex = on ? 0 : -1;\n      panels[i].hidden = !on;\n      if (on && focus) {\n        tab.focus();\n      }\n    });\n    onChange(view);\n  };\n  list.addEventListener('click', (event) => {\n    const tab = event.target.closest?.('[role=\"tab\"]');\n    if (tab) {\n      select(tab.dataset.view);\n    }\n  });\n  list.addEventListener('keydown', (event) => {\n    const at = tabs.indexOf(event.target);\n    const moves = {\n      ArrowRight: at + 1,\n      ArrowLeft: at - 1,\n      Home: 0,\n      End: tabs.length - 1,\n    };\n    if (at < 0 || !(event.key in moves)) {\n      return;\n    }\n    event.preventDefault();\n    const next = (moves[event.key] + tabs.length) % tabs.length;\n    select(tabs[next].dataset.view, true);\n  });\n  return { select, panels };\n}\n\n/** The WAI-ARIA window splitter on the left edge of the panel. */\nfunction buildSplitter(host, shadow, t, window) {\n  const doc = shadow.ownerDocument;\n  const splitter = doc.createElement('div');\n  splitter.className = 'splitter';\n  splitter.tabIndex = 0;\n  splitter.setAttribute('role', 'separator');\n  splitter.setAttribute('aria-orientation', 'vertical');\n  splitter.setAttribute('aria-label', t('resize.label'));\n  splitter.setAttribute('aria-valuemin', String(WIDTH.min));\n  const max = () => Math.max(WIDTH.min, Math.round(window.innerWidth * 0.9));\n  const setWidth = (width) => {\n    const clamped = Math.round(Math.min(max(), Math.max(WIDTH.min, width)));\n    host.style.setProperty('--devmode-width', `${clamped}px`);\n    splitter.setAttribute('aria-valuemax', String(max()));\n    splitter.setAttribute('aria-valuenow', String(clamped));\n    return clamped;\n  };\n  let width = setWidth(WIDTH.initial);\n  splitter.addEventListener('keydown', (event) => {\n    const keys = {\n      ArrowLeft: width + WIDTH.step,\n      ArrowRight: width - WIDTH.step,\n      Home: max(),\n      End: WIDTH.min,\n    };\n    if (event.key in keys) {\n      event.preventDefault();\n      width = setWidth(keys[event.key]);\n    }\n  });\n  splitter.addEventListener('pointerdown', (event) => {\n    event.preventDefault();\n    splitter.setPointerCapture?.(event.pointerId);\n    const move = (e) => {\n      width = setWidth(window.innerWidth - e.clientX);\n    };\n    const up = () => {\n      splitter.removeEventListener('pointermove', move);\n      splitter.removeEventListener('pointerup', up);\n    };\n    splitter.addEventListener('pointermove', move);\n    splitter.addEventListener('pointerup', up);\n  });\n  return { splitter, setWidth: (w) => (width = setWidth(w)) };\n}\n\n/**\n * Create the inspector panel and append it to the page.\n * @param {{ window: Window & typeof globalThis, layout: string,\n *   t: (key: string, params?: object) => string,\n *   onCommand: (command: string) => void,\n *   onView?: (view: string) => void }} options\n */\nexport function createInspector({ window, layout, t, onCommand, onView }) {\n  const doc = window.document;\n  const host = doc.createElement('ui-devmode-inspector');\n  host.dataset.uiDevmode = 'inspector';\n  const shadow = host.attachShadow({ mode: 'open' });\n  const { splitter, setWidth } = buildSplitter(host, shadow, t, window);\n  const frame = doc.createElement('div');\n  frame.className = 'frame';\n  shadow.append(splitter, frame);\n  doc.body.append(host);\n  const mounted = mountDocument(frame, layout, {\n    parseOptions: { vocabulary: LAYOUT_VOCABULARY },\n    kinds: LAYOUT_KINDS,\n    t,\n    baseCss: false,\n    css: INSPECTOR_CSS,\n  });\n  mounted.handle.flush?.();\n\n  let view = 'outline';\n  const tabs = buildTabs(shadow, (next) => {\n    view = next;\n    onView?.(next);\n  });\n  const button = (command) =>\n    shadow.querySelector(`button[data-command=\"${command}\"]`);\n  shadow.addEventListener('click', (event) => {\n    const target = event.target.closest?.('button[data-command]');\n    if (target && !target.disabled) {\n      onCommand(target.dataset.command);\n    }\n  });\n  const status = shadow.querySelector('[data-role=\"live\"]');\n  const selection = shadow.querySelector('[data-role=\"selection\"]');\n\n  return {\n    host,\n    shadow,\n    /** The panel element of a view (`outline`, `properties`, …). */\n    panel: (name) =>\n      shadow.querySelector(`[role=\"tabpanel\"][data-view=\"${name}\"]`),\n    get view() {\n      return view;\n    },\n    showView: (name, focus = false) => tabs.select(name, focus),\n    setPressed(command, pressed) {\n      button(command)?.setAttribute('aria-pressed', String(pressed));\n    },\n    setDisabled(command, disabled) {\n      const target = button(command);\n      if (target) {\n        target.disabled = disabled;\n      }\n    },\n    setSelection(textContent) {\n      selection.textContent = textContent;\n    },\n    announce(textContent) {\n#!/usr/bin/env node\n/**\n * Static server for the Playwright UI tests (playwright.config.mjs).\n *\n * Mounts:\n *   /tests/ui/pages/          -> tests/ui/pages/\n *   /packages/<name>/e2e/pages/ -> packages/<name>/e2e/pages/ (when present)\n *   /example-app/             -> examples/universal-app/dist/\n *   /examples/ui-dom/         -> examples/ui-dom/ (the ui-dom example page)\n *   /examples/animation/      -> examples/animation/ (the ui-animation example)\n *   /packages/<name>/src/     -> packages/<name>/src/ (ES modules of the\n *                                import map of the example pages)\n *   /packages/<name>/examples/ -> packages/<name>/examples/ (when present;\n *                                the ui-components chart, diagram and icon\n *                                galleries)\n *   /packages/<name>/stories/ -> packages/<name>/stories/ (when present; the\n *                                story files of the controls gallery)\n *   /packages/<name>/dist/    -> packages/<name>/dist/ (build output, such\n *                                as the icon modules of build-icons.mjs)\n *   /node_modules/links-notation/dist/ -> the browser build of links-notation\n *   /node_modules/<d3 package>/ -> the ES modules of d3-scale, d3-shape and\n *                                their dependencies (the chart gallery)\n *   /node_modules/echarts/dist/ -> the optional ECharts build\n *   /node_modules/@dagrejs/dagre/dist/ -> the browser build of Dagre\n *   /node_modules/mermaid/dist/ -> the browser build of Mermaid (the optional\n *                                peer of ui-components, loaded on demand)\n *   /docs/case-studies/issue-1/samples/ -> the sample documents\n *\n * Usage: node scripts/serve-static.mjs [--port 4173] [--host 127.0.0.1]\n */\nimport { createRequire } from 'node:module';\nimport { existsSync, readdirSync } from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\n\nimport { buildNetworkWorker } from './build-network-worker.mjs';\nimport { startStaticServer } from './lib/static-server.mjs';\n\nconst repoRoot = path.resolve(\n  path.dirname(fileURLToPath(import.meta.url)),\n  '..'\n);\n\n/** The npm packages the chart gallery loads as ES modules (no bundler). */\nexport const BROWSER_MODULES = [\n  'd3-force',\n  'd3-dispatch',\n  'd3-quadtree',\n  'd3-timer',\n  'd3-array',\n  'd3-color',\n  'd3-format',\n  'd3-interpolate',\n  'd3-path',\n  'd3-scale',\n  'd3-shape',\n  'd3-time',\n  'd3-time-format',\n  'internmap',\n];\n\n/** ESM dependencies of the source editor example, plus its optional peer. */\nconst EDITOR_BROWSER_MODULES = [\n  '@marijn/find-cluster-break',\n  '@codemirror/commands',\n  '@codemirror/language',\n  '@codemirror/state',\n  '@codemirror/streamparser',\n  '@codemirror/view',\n  'crelt',\n  'style-mod',\n  'w3c-keyname',\n  '@lezer/common',\n  '@lezer/highlight',\n  '@lezer/lr',\n  '@codemirror/lang-css',\n  '@codemirror/autocomplete',\n  '@lezer/css',\n  '@codemirror/lang-javascript',\n  '@codemirror/lint',\n  '@lezer/javascript',\n  '@codemirror/lang-json',\n  '@lezer/json',\n  '@codemirror/lang-markdown',\n  '@codemirror/lang-html',\n  '@lezer/html',\n  '@lezer/markdown',\n];\n\n/**\n * @param {string} root repository root\n * @returns {{prefix: string, dir: string}[]}\n */\nexport function defaultMounts(root) {\n  const mounts = [\n    {\n      prefix: '/tests/ui/pages/',\n      dir: path.join(root, 'tests', 'ui', 'pages'),\n    },\n    {\n      prefix: '/example-app/',\n      dir: path.join(root, 'examples', 'universal-app', 'dist'),\n    },\n  ];\n  for (const parts of [\n    ['examples', 'ui-dom'],\n    ['examples', 'animation'],\n    ['examples', 'themes'],\n    ['node_modules', 'links-notation', 'dist'],\n    ...BROWSER_MODULES.map((name) => ['node_modules', name]),\n    ...EDITOR_BROWSER_MODULES.map((name) => [\n      'node_modules',\n      ...name.split('/'),\n    ]),\n    ['node_modules', 'monaco-editor', 'min'],\n    ['node_modules', 'echarts', 'dist'],\n    ['node_modules', '@dagrejs', 'dagre', 'dist'],\n    ...['dom', 'core', 'utils'].map((name) => [\n      'node_modules',\n      '@floating-ui',\n      name,\n      'dist',\n    ]),\n    ['node_modules', 'mermaid', 'dist'],\n    ['docs', 'case-studies', 'issue-1', 'samples'],\n  ]) {\n    mounts.push({\n      prefix: `/${parts.join('/')}/`,\n      dir:\n        parts.join('/') === 'node_modules/d3-force'\n          ? path.dirname(\n              path.dirname(\n                createRequire(\n                  path.join(root, 'packages/ui-components/package.json')\n                ).resolve('d3-force')\n              )\n            )\n          : path.join(root, ...parts),\n    });\n  }\n  const packagesDir = path.join(root, 'packages');\n  if (existsSync(packagesDir)) {\n    for (const name of readdirSync(packagesDir).sort()) {\n      for (const sub of [\n        ['e2e', 'pages'],\n        ['src'],\n        ['stories'],\n        ['themes'],\n        ['examples'],\n        ['dist'],\n      ]) {\n        const dir = path.join(packagesDir, name, ...sub);\n        if (existsSync(dir)) {\n          mounts.push({ prefix: `/packages/${name}/${sub.join('/')}/`, dir });\n        }\n      }\n    }\n  }\n  return mounts;\n}\n\nfunction parseArgs(argv) {\n  const args = { port: 4173, host: '127.0.0.1' };\n  for (let i = 0; i < argv.length; i += 1) {\n    if (argv[i] === '--port') {\n      args.port = Number(argv[(i += 1)]);\n    } else if (argv[i] === '--host') {\n      args.host = argv[(i += 1)];\n    } else {\n      throw new Error(`Unknown argument: ${argv[i]}`);\n    }\n  }\n  return args;\n}\n\nif (process.argv[1] === fileURLToPath(import.meta.url)) {\n  const { port, host } = parseArgs(process.argv.slice(2));\n  await buildNetworkWorker(repoRoot);\n  const server = await startStaticServer({\n    mounts: defaultMounts(repoRoot),\n    port,\n    host,\n  });\n  console.log(`[serve-static] listening on ${server.url}`);\n}\n/**\n * @link-foundation/ui-config: every property of a UI document resolved\n * through the configuration layers defaults < theme < site < user < session,\n * with overrides read and written as Links Notation `overrides` patches.\n */\n\nexport { createConfig } from './config.js';\nexport {\n  LAYERS,\n  EDITABLE_LAYERS,\n  DEFAULT_KEYED_PROPS,\n  DOCUMENT_LAYER,\n  KEY_SEPARATOR,\n  overrideKey,\n} from './lay