[2026-11-03T21:17:44.123Z] [STDOUT] {"type":"item.completed","item":{"id":"item_423","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,210p' .github/workflows/ui-tests.yml; git status --porcelain=v1\"","aggregated_output":"name: UI tests\n\n# Visual regression (toHaveScreenshot) and WCAG 2.2 A/AA (axe-core) tests.\n# See docs/testing-ui.md. Issue: #13.\non:\n  pull_request:\n  push:\n    branches: [main]\n  workflow_dispatch:\n    inputs:\n      update-snapshots:\n        description: Regenerate screenshot baselines and upload them as an artifact\n        type: boolean\n        default: false\n\npermissions:\n  contents: read\n\njobs:\n  ui-tests:\n    name: UI tests (Playwright + axe)\n    runs-on: ubuntu-24.04\n    container:\n      # Same image digest as preview-regen in example-app.yml. Keep the tag\n      # comment equal to the @playwright/test pin in package.json\n      # (scripts/check-playwright-version.mjs enforces it).\n      image: mcr.microsoft.com/playwright@sha256:b0ab6f3cb99aa7803adbc14d9027ec1785fc6e433b97e134e0f8fe61683b6b53 # v1.59.1-noble\n    timeout-minutes: 20\n    concurrency:\n      group: check-${{ github.workflow }}-${{ github.ref }}-ui-tests\n      cancel-in-progress: true\n    env:\n      PLAYWRIGHT_BROWSERS_PATH: /ms-playwright\n      PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD: '1'\n      UPDATE_SNAPSHOTS: ${{ github.event_name == 'workflow_dispatch' && inputs.update-snapshots }}\n    # Container jobs run `run:` blocks with sh, which has no [[ ]].\n    defaults:\n      run:\n        shell: bash\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1\n        with:\n          persist-credentials: false\n\n      # The container user (root) does not own the runner's workspace.\n      - name: Trust the checkout\n        run: git config --global --add safe.directory \"$GITHUB_WORKSPACE\"\n\n      - name: Check Playwright version pins\n        run: node scripts/check-playwright-version.mjs\n\n      - name: Install dependencies\n        run: npm ci --no-audit --no-fund\n\n      - name: Install example app dependencies\n        run: npm ci --prefix examples/universal-app --no-audit --no-fund\n\n      - name: Build example app\n        run: npm run example:web:build\n\n      # The icon gallery loads the generated sets from the gitignored dist/.\n      - name: Build icon sets\n        run: npm run build:icons\n\n      - name: Build foreign dev mode and unpacked extension\n        run: npm run build --workspace @link-foundation/ui-devmode-extension\n\n      - name: Install Expo example dependencies\n        run: npm ci --prefix examples/react-native --no-audit --no-fund\n\n      - name: Export Expo example through React Native Web\n        run: npm --prefix examples/react-native run build\n\n      - name: Test native web keyboard actions and accessibility\n        run: npx playwright test --config examples/react-native/playwright.config.mjs\n\n      - name: Run Playwright tests\n        if: env.UPDATE_SNAPSHOTS != 'true'\n        run: npx playwright test\n\n      - name: Update screenshot baselines\n        if: env.UPDATE_SNAPSHOTS == 'true'\n        run: npx playwright test --update-snapshots\n\n      - name: Retain network performance traces\n        if: always()\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: network-performance-${{ github.run_id }}-${{ github.run_attempt }}\n          path: |\n            test-results/**/trace.zip\n            test-results/**/attachments/canvas-pan-performance*\n          retention-days: 7\n          if-no-files-found: error\n\n      - name: Upload test report and diffs\n        if: failure()\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: ui-tests-failure-${{ github.run_id }}-${{ github.run_attempt }}\n          path: |\n            playwright-report/\n            test-results/\n            examples/react-native/test-results/\n          retention-days: 7\n          if-no-files-found: error\n\n      # A human downloads this artifact and commits it; the job never pushes.\n      - name: Upload updated baselines\n        if: env.UPDATE_SNAPSHOTS == 'true'\n        uses: ./.github/actions/artifact-transport\n        with:\n          name: ui-screenshots-${{ github.run_id }}\n          path: |\n            tests/ui/__screenshots__/**\n            tests/e2e/__screenshots__/**\n            packages/*/e2e/__screenshots__/**\n            packages/*/tests/e2e/__screenshots__/**\n          retention-days: 7\n          if-no-files-found: error\n","exit_code":0,"status":"completed"}}
