[2026-11-03T20:51:40.828Z] [STDOUT] {"type":"item.completed","item":{"id":"item_243","type":"command_execution","command":"/bin/bash -lc 'cat packages/ui-devmode/tests/foreign-adapter.test.js; cat packages/ui-devmode/src/foreign/properties.js; cat packages/ui-devmode/README.md | tail -n 58'","aggregated_output":"import { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport { JSDOM } from 'jsdom';\nimport { importDom } from '@link-foundation/ui-convert';\nimport { readPatch } from '@link-foundation/ui-config';\nimport { createForeignAdapter } from '../src/foreign/adapter.js';\n\nfunction setup(t) {\n  const dom = new JSDOM(\n    '<body><h2 id=\"title\" style=\"color:blue\">Hello</h2><p>Card</p><ui-foreign-devmode></ui-foreign-devmode></body>'\n  );\n  const root = dom.window.document.body;\n  const ignore = (node) => node.localName === 'ui-foreign-devmode';\n  const adapter = createForeignAdapter({ root, ignore });\n  t.after(() => {\n    adapter.destroy();\n    dom.window.close();\n  });\n  return { dom, root, adapter, ignore };\n}\n\ntest('foreign adapter preserves importer IDs and never annotates DOM', (t) => {\n  const { root, adapter, ignore } = setup(t);\n  const before = root.outerHTML;\n  const expected = importDom(root, { ignore });\n  assert.deepEqual(\n    [...adapter.tree().toDocument().byId.keys()],\n    [...expected.tree.byId.keys()]\n  );\n  for (const [id, node] of expected.nodeMap) {\n    assert.equal(adapter.nodeFor(id), node);\n    assert.equal(adapter.idFor(node), id);\n  }\n  assert.equal(root.outerHTML, before);\n  assert.equal(adapter.tree().toDocument().roots[0].children.length, 2);\n});\n\ntest('foreign adapter records keyed session edits and exports valid migration LiNo', (t) => {\n  const { root, adapter } = setup(t);\n  adapter.applyProperty('title', 'text', 'Changed');\n  adapter.applyProperty('title', 'style color', 'red');\n  assert.equal(root.querySelector('h2').textContent, 'Changed');\n  assert.equal(root.querySelector('h2').style.color, 'red');\n  const patch = readPatch(adapter.exportOverrides().text, {\n    keyedProps: ['attr', 'style'],\n  });\n  assert.equal(patch.ops.length, 2);\n  assert.ok(patch.ops.every((op) => op.op === 'set'));\n  assert.match(adapter.subtree('title'), /Changed/);\n  adapter.refresh();\n  assert.equal(adapter.exportOverrides().count, 2);\n  adapter.config.clear('session');\n  assert.equal(root.querySelector('h2').textContent, 'Hello');\n  assert.equal(root.querySelector('h2').style.color, 'blue');\n});\n\ntest('foreign adapter restores only safe edits and tracks replacement nodes', (t) => {\n  const { root, adapter } = setup(t);\n  const rejected = adapter.restore(\n    'saved: overrides\\n  layer session\\n  set title text Saved\\n  set title attr onclick bad\\n'\n  );\n  assert.equal(rejected.length, 1);\n  assert.equal(root.querySelector('h2').textContent, 'Saved');\n  const replacement = root.ownerDocument.createElement('h2');\n  replacement.id = 'title';\n  replacement.textContent = 'New';\n  root.querySelector('h2').replaceWith(replacement);\n  adapter.refresh();\n  assert.equal(adapter.nodeFor('title'), replacement);\n  assert.equal(adapter.idFor(replacement), 'title');\n  assert.equal(replacement.textContent, 'Saved');\n  adapter.config.clear('session');\n  assert.equal(replacement.textContent, 'New');\n});\n\ntest('new attributes reset to absence after a DOM refresh', (t) => {\n  const { root, adapter } = setup(t);\n  adapter.applyProperty('title', 'attr title', 'Tooltip');\n  adapter.refresh();\n  assert.equal(adapter.exportOverrides().count, 1);\n  adapter.config.clear('session');\n  assert.equal(root.querySelector('h2').hasAttribute('title'), false);\n});\n\ntest('closed shadow roots remain a single opaque imported host', (t) => {\n  const { root, adapter } = setup(t);\n  const host = root.ownerDocument.createElement('closed-widget');\n  host.id = 'widget';\n  host.attachShadow({ mode: 'closed' }).innerHTML =\n    '<b id=\"secret\">Private</b>';\n  root.append(host);\n  adapter.refresh();\n  assert.equal(adapter.nodeFor('widget'), host);\n  assert.equal(adapter.nodeFor('secret'), null);\n  assert.equal(adapter.tree().children('widget').length, 0);\n});\n\ntest('importDom ignore excludes whole hosts before structural IDs are assigned', () => {\n  const { document } = new JSDOM(\n    '<body><aside><b>Inspector</b></aside><p>Page</p></body>'\n  ).window;\n  const ignored = importDom(document.body, {\n    ignore: (node) => node.localName === 'aside',\n  });\n  const plain = importDom(\n    new JSDOM('<body><p>Page</p></body>').window.document.body\n  );\n  assert.equal(ignored.text, plain.text);\n});\nimport { formatValues } from '../model.js';\nimport { checkProperty, readProperty } from './apply.js';\nconst nameOf = (op) =>\n  op.key === null || op.key === undefined ? op.name : `${op.name} ${op.key}`;\n\nexport function updateOriginals(originals, nodeMap) {\n  for (const original of originals.values()) {\n    const node = nodeMap.get(original.id);\n    if (node && node !== original.node) {\n      original.node = node;\n      original.value = readProperty(node, original.name);\n      original.priority = original.name.startsWith('style ')\n        ? node.style.getPropertyPriority(original.name.slice(6))\n        : '';\n    }\n  }\n}\nexport function baseDocument(nodeMap, originals) {\n  return [...nodeMap].map(([id, node]) => {\n    const properties = [];\n    const added = new Set();\n    const add = (label, value) => {\n      if (added.has(label)) {\n        return;\n      }\n      added.add(label);\n      const original = originals.get(JSON.stringify([id, label]));\n      value = original ? original.value : value;\n      if (value === null || value === undefined) {\n        return;\n      }\n      const [name, key] = label.split(' ');\n      properties.push({ name, values: key ? [key, value] : [value] });\n    };\n    if (node.nodeType === 3 || (node.nodeType === 1 && !node.children.length)) {\n      add('text', node.textContent);\n    }\n    if (node.nodeType === 1) {\n      for (const attr of node.attributes) {\n        if (attr.name !== 'style') {\n          add(`attr ${attr.name}`, attr.value);\n        }\n      }\n      for (let i = 0; i < node.style.length; i++) {\n        const name = node.style.item(i);\n        add(`style ${name}`, node.style.getPropertyValue(name));\n      }\n      for (const original of originals.values()) {\n        if (original.id === id) {\n          add(original.name, original.value);\n        }\n      }\n    }\n    return {\n      id,\n      kind: 'foreign-node',\n      positional: [],\n      properties,\n      children: [],\n      unknown: [],\n    };\n  });\n}\nexport function foreignRows(adapter, config, allOps, id) {\n  const node = adapter.nodeFor(id);\n  if (!node) {\n    return [];\n  }\n  const names = new Set();\n  if (\n    node.nodeType === 3 ||\n    (node.nodeType === 1 &&\n      !node.children.length &&\n      !['script', 'style'].includes(node.localName))\n  ) {\n    names.add('text');\n  }\n  if (node.nodeType === 1) {\n    for (const attr of node.attributes) {\n      if (attr.name !== 'style') {\n        names.add(`attr ${attr.name}`);\n      }\n    }\n    for (const prop of Array.from({ length: node.style.length }, (_, i) =>\n      node.style.item(i)\n    )) {\n      names.add(`style ${prop}`);\n    }\n    names.add('attr title');\n    names.add('style color');\n    for (const op of allOps().filter((op) => op.id === id)) {\n      names.add(nameOf(op));\n    }\n  }\n  return [...names].flatMap((label) => {\n    const value = readProperty(node, label) ?? '';\n    try {\n      checkProperty(node, label, value);\n    } catch {\n      return [];\n    }\n    const [name, key = null] = label.split(' ');\n    const changed = [...allOps()]\n      .reverse()\n      .find((op) => op.id === id && nameOf(op) === label);\n    return [\n      {\n        name,\n        key,\n        label,\n        type: 'string',\n        editor: 'string',\n        value: [value],\n        text: formatValues([value]),\n        layer: changed\n          ? config.valueIn('session', id, name, key ?? undefined)\n            ? 'session'\n            : 'user'\n          : 'site',\n        changed: Boolean(changed),\n        locked: false,\n        writable: true,\n      },\n    ];\n  });\n}\n\n`exportOverrides(config, { id, base, layers })` returns `{ text, links, count }`.\nOnly `user` and `session` layers are accepted; their effective difference from\nsite is sorted by element ID, property and token key. The codec exports\n`encodeShareHash`, `decodeShareHash` (malformed hashes return `null`) and\n`shareUrl` (`{ url, tooLong }`, including the full URL in its budget).\n\nThe runnable example is `packages/ui-devmode/examples/?ui-dev`.\n`packages/ui-devmode/e2e/defaults.e2e.mjs` covers label editing, share preview,\nKeep/Discard, clipboard fallback, modal keyboard use, axe and URL budgets.\n\n## Foreign pages: bookmarklet and extension\n\nDev mode also works on pages that do not use ui-dom. The foreign adapter uses\n`importDom` from ui-convert, keeps node mappings in a WeakMap, and never adds\nmapping attributes to the page. The same inspector lives in a fixed shadow host.\nPick an element, open Properties, and edit leaf `text`, `attr <name>` or\n`style <property>` rows. Existing attributes and inline declarations are listed;\n`attr title` and `style color` are available even when absent. Arbitrary safe\nproperties can also be set with\n`linkUiForeignDevMode.setProperty(id, 'style background-color', '#eef')`.\nEvent attributes, script URLs, `srcdoc`, and whole-style attribute writes are\nrefused. Text edits cannot replace an element's children. Closed shadow roots\nstay opaque; cross-origin iframe contents are not inspected.\n\nChanges write the session configuration layer and are automatically persisted\nper origin and pathname as LiNo under `link-ui-devmode:<origin>:<pathname>`.\nReopening restores them; Save promotes the session to user and Discard removes\nsession edits. Reset restores the previous value, including an absent attribute.\nDOM changes re-import after 200 ms; stable IDs keep their selection. Structural\nIDs may change when siblings are inserted; use existing HTML IDs when possible.\nCopy overrides as LiNo exports one `set` per changed property; Copy subtree as\nLiNo exports the selected live subtree for migration. Clipboard denial presents\na selected textarea for manual copying. `whenSaved()` waits for pending writes;\n`storageError` and `restoreError` expose unavailable storage or invalid data.\n\nBuild with `npm run build --workspace @link-foundation/ui-devmode`. It writes\n`dist/foreign.js` (one ES module), `dist/devmode.js` (the extension bundle) and\n`dist/bookmarklet.txt`. Set `UI_DEVMODE_BUNDLE_URL=https://your-host/foreign.js`\nat build time to configure the bookmarklet loader. Host the ES module with a\nJavaScript content type and CORS permission for the inspected origin. The default\nURL reserves the future documentation hosting location; self-host the bundle\nuntil that location is deployed. Drag a bookmark whose URL is the contents of\n`bookmarklet.txt` into the bookmarks bar, then click it on the page to toggle.\n\n**Strict Content Security Policy (CSP) blocks the bookmarklet**, including the\nloader or its module request. Use the browser extension on these pages. The\n`tests/fixtures/foreign-csp.html` fixture checks this with `script-src 'none'`.\nThe extension injects a packaged script in Chrome's isolated world and uses\n`chrome.storage.local`; it does not fetch executable code from the web.\nSee [extension instructions](../ui-devmode-extension/README.md). Restricted\nbrowser pages cannot be inspected. No Firefox support is claimed.\n\nFor programmatic use, import `mountForeignDevMode` from\n`@link-foundation/ui-devmode/foreign`; pass an optional `window`, inspector\n`layout` LiNo, or async `{ getItem, setItem }` storage wrapper. The returned\ncontroller supports select, exportOverrides, exportSubtree, close/toggle and\nasync destroy. Repeated mounting toggles the existing controller.\n","exit_code":0,"status":"completed"}}
