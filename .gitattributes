# Shell scripts and Git hooks require LF on every platform.
*.sh text eol=lf
.husky/** text eol=lf

# LiNo documents are parser inputs: docs/spec/parser-vectors.json records their
# exact bytes (inputs, lines and columns), and the spec samples must equal the
# case-study samples byte for byte, so none may gain CRLF on a Windows checkout.
*.lino text eol=lf
docs/spec/fixtures/** text eol=lf
docs/spec/parser-vectors.json text eol=lf

# The ui-tokens golden files are the exact outputs of the writers, which always
# use LF, and the tests compare them byte for byte.
packages/ui-tokens/tests/golden/** text eol=lf
packages/ui-style/tests/golden/** text eol=lf

# UiSwiftUI vendors the ui-tokens Swift output, and tests/ui-swift-tokens.test.js
# compares it byte for byte with what ui-tokens writes (always LF).
packages/ui-swift/Sources/UiSwiftUI/Tokens.swift text eol=lf

# The issue-101 roadmap sources are read by the front-matter parser of
# experiments/issue-1/create-roadmap-issues.mjs, which expects LF, and
# tests/issue-101-roadmap.test.js compares the bodies built from them.
docs/case-studies/issue-101/roadmap/** text eol=lf

# The ui-links fixtures are byte copies of link-cli files (links-operations.txt
# is its protocol conversation); server.test.js replays them line by line.
packages/ui-links/tests/fixtures/** text eol=lf

# The ui-dom snapshots are the exact HTML the renderer writes (always LF), and
# the tests compare them byte for byte.
packages/ui-dom/tests/__snapshots__/** text eol=lf

# The own icon module is written by scripts/build-icons.mjs (always LF), and
# `npm run check:icons` compares it byte for byte.
packages/ui-components/src/icons/own-icons.js text eol=lf

# The chart SVG snapshots are the exact output of renderChartSvg (always LF),
# and the tests compare them byte for byte.
packages/ui-components/tests/charts/__snapshots__/** text eol=lf

# The ui-components diagram fixtures: login-flow.mmd is the exact text toMermaid
# writes (always LF, no trailing newline), compared byte for byte.
packages/ui-components/tests/diagrams/fixtures/** text eol=lf

# The link-view SVG snapshot is the exact output of renderLinkSvg (always LF),
# and render-svg.test.js compares it byte for byte.
packages/ui-components/tests/links-view/__snapshots__/** text eol=lf

# Recorder export snapshots are the exact LF output of toPlaywright.
packages/ui-animation/tests/fixtures/recording-session.spec.txt text eol=lf
tests/e2e/fixtures/recorder-generated.mjs text eol=lf
tests/e2e/fixtures/recorder-native-generated.mjs text eol=lf

# Generated Markdown is compared byte for byte with the LF writer output.
docs/themes/material3.md text eol=lf
