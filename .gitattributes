# Shell scripts and Git hooks require LF on every platform.
*.sh text eol=lf
.husky/** text eol=lf

# LiNo documents are parser inputs: docs/spec/parser-vectors.json records their
# exact bytes (inputs, lines and columns), and the spec samples must equal the
# case-study samples byte for byte, so none may gain CRLF on a Windows checkout.
*.lino text eol=lf
docs/spec/fixtures/** text eol=lf
docs/spec/parser-vectors.json text eol=lf

# The ui-tokens golden files are the exact outputs of the writers, which always
# use LF, and the tests compare them byte for byte.
packages/ui-tokens/tests/golden/** text eol=lf

# UiSwiftUI vendors the ui-tokens Swift output, and tests/ui-swift-tokens.test.js
# compares it byte for byte with what ui-tokens writes (always LF).
packages/ui-swift/Sources/UiSwiftUI/Tokens.swift text eol=lf
