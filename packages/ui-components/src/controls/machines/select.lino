select-machine: machine
  initial closed
  context
    disabled false
    invalid false
  action open-list
    activate selected
  action close-list
    activate none
  state closed
    on toggle
      target open
      do open-list
      when not-disabled
    on open
      target open
      do open-list
      when not-disabled
    on next
      target open
      do open-list
      when not-disabled
    on previous
      target open
      do open-list
      when not-disabled
    on first
      target open
      do open-list
        activate first
      when not-disabled
    on last
      target open
      do open-list
        activate last
      when not-disabled
    on page-next
      target open
      do open-list
        activate pageNext
      when not-disabled
    on page-previous
      target open
      do open-list
        activate pagePrevious
      when not-disabled
    on commit
      target open
      do open-list
      when not-disabled
    on typeahead
      target open
      do open-list typeahead
      when not-disabled
  state open
    on toggle
      target closed
      do close-list
    on close
      target closed
      do close-list
    on blur
      target closed
      do select-active close-list
    on next
      do
        activate next
    on previous
      do
        activate previous
    on first
      do
        activate first
    on last
      do
        activate last
    on page-next
      do
        activate pageNext
    on page-previous
      do
        activate pagePrevious
    on typeahead
      do typeahead
    on commit
      target closed
      do select-active close-list
    on pick
      target closed
      do select-picked close-list
  part input
    attr role combobox
    attr aria-haspopup listbox
    attr aria-expanded
      in open
    attr aria-activedescendant
      context active
    attr aria-invalid
      context invalid
    attr data-state
      state
    key ArrowDown next
    key ArrowUp previous
    key Alt+ArrowDown open
    key Alt+ArrowUp commit
    key Home first
    key End last
    key PageDown page-next
    key PageUp page-previous
    key Enter commit
    key Space commit
    key Escape close
    on press toggle
    on focusout blur
  part listbox
    attr role listbox
    attr hidden
      present
        in closed
    attr data-state
      state
    on click pick
