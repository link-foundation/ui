whatsapp: theme
  token chat.bg '#efeae2'
  token chat.sidebar '#ffffff'
  token chat.bubble.in '#ffffff'
  token chat.bubble.in.text '#111b21'
  token chat.bubble.out '#d9fdd3'
  token chat.bubble.out.text '#111b21'
  token chat.bubble.radius 7.5px
  token chat.bubble.tail 11.5px
  token chat.bubble.padding.block 0.35rem
  token chat.bubble.padding.inline 0.6rem
  token chat.text '#17212b'
  token chat.column 44rem
  token chat.selection.bg '#164e63'
  token chat.selection.text '#ffffff'
  mode dark
    token chat.bg '#0b141a'
    token chat.sidebar '#111b21'
    token chat.bubble.in '#202c33'
    token chat.bubble.in.text '#e9edef'
    token chat.bubble.out '#005c4b'
    token chat.bubble.out.text '#e9edef'
    token chat.text '#f4f6f8'
    token chat.selection.bg '#b9e6fb'
    token chat.selection.text '#102b39'
