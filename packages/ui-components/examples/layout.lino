(gallery: app-shell
  (label 'Layout gallery')
  (bottom-bar nav)
  (rail nav)
  (drawer nav)
  (nav: stack
    (direction vertical)
    (gap 8px)
    (go-designer: button 'Designer' (on press (focus designer)))
    (go-chat: button 'Chat' (on press (focus chat)))
    (go-tabs: button 'Tabs' (on press (focus inspector-tabs))))
  (main: stack
    (direction vertical)
    (gap 16px)
    (padding 16px)
    (align stretch)
    (designer: dock
      (label Designer)
      (persist gallery.designer)
      (left: region (size 16rem) (panels toolbox outline))
      (right: region (size 18rem) (panels properties))
      (center: region (panels canvas))
      (toolbox: panel (title Toolbox) (toolbox-items: text 'Button · Text · Image · Stack'))
      (outline: panel (title Outline) (outline-tree: text 'page › header › title'))
      (properties: panel (title Properties) (properties-list: text 'width 320 · height 200'))
      (canvas: panel (title Canvas) (closable false) (canvas-hint: text 'Drop elements here')))
    (chat: split
      (label Chat)
      (sizes 30 70)
      (min 20)
      (collapsible true false)
      (remember-size gallery.chat)
      (chat-list: panel (title Chats) (chat-list-body: text 'Ada · Grace · Linus'))
      (chat-view: panel (title Messages) (chat-view-body: text 'Hello! · How is the layout going?')))
    (inspector-tabs: tab-group
      (label Inspector)
      (styles: panel (title Styles) (closable true) (styles-body: text 'color · padding · gap'))
      (events: panel (title Events) (closable true) (events-body: text 'press → (set inspector open true)'))
      (data: panel (title Data) (closable true) (data-body: text 'bind (user name)')))
    (open-window: button 'Open inspector window' (on press (set inspector open true)))
    (grid-demo: grid
      (columns 1fr 1fr 1fr)
      (gap 8px)
      (cell-a: text 'Grid cell A')
      (cell-b: text 'Grid cell B')
      (cell-c: text 'Grid cell C'))
    (inspector: window
      (title 'Inspector window')
      (open false)
      (x 240)
      (y 120)
      (width 320)
      (height 200)
      (inspector-hint: text 'Alt+Arrow moves this window; Alt+Shift+Arrow resizes it; Escape closes it.'))))
