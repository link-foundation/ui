(sales: chart
  (title 'Monthly sales')
  (description 'Sales grew from 12 to 30 thousand between January and June 2026')
  (data
    (row (month 2026-01) (value 12))
    (row (month 2026-02) (value 18))
    (row (month 2026-03) (value 15))
    (row (month 2026-04) (value 21))
    (row (month 2026-05) (value 25))
    (row (month 2026-06) (value 30)))
  (mark line (point true))
  (encoding
    (x (field month) (type temporal) (title Month))
    (y (field value) (type quantitative) (title 'Sales, thousand USD'))))
