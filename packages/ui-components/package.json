{
  "name": "@link-foundation/ui-components",
  "version": "0.0.0",
  "description": "Components of the associative UI framework written in Links Notation: charts described with the grammar of Vega-Lite (data, mark, encoding), rendered as deterministic SVG with d3-scale and d3-shape, with an accessible table twin and an optional lazy ECharts adapter",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./charts": {
      "types": "./src/index.d.ts",
      "default": "./src/charts/index.js"
    },
    "./charts/echarts": {
      "types": "./src/index.d.ts",
      "default": "./src/charts/echarts-adapter.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "components",
    "charts",
    "vega-lite",
    "svg",
    "accessibility",
    "custom-elements"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-components"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-components#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.1",
    "links-notation": "^0.27.1"
  },
  "peerDependencies": {
    "echarts": "^6.1.0"
  },
  "peerDependenciesMeta": {
    "echarts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@link-foundation/ui-tokens": "^0.0.0",
    "echarts": "6.1.0",
    "jsdom": "^30.1.3",
    "test-anywhere": "^0.8.48"
  },
  "publishConfig": {
    "access": "public"
  }
}
