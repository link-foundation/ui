{
  "name": "@link-foundation/ui-components",
  "version": "0.0.0",
  "description": "Components of the associative UI framework written in Links Notation: diagrams described in LiNo (flowchart, state, sequence, class), laid out by Dagre or a registered layout plugin, rendered as accessible SVG, exported to Mermaid text or rendered by a lazily loaded Mermaid adapter",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./diagrams": {
      "types": "./src/diagrams/index.d.ts",
      "default": "./src/diagrams/index.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "diagram",
    "flowchart",
    "mermaid",
    "dagre",
    "svg",
    "custom-elements"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-components"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-components#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "links-notation": "^0.27.1"
  },
  "peerDependencies": {
    "mermaid": "^11.0.0 || ^12.0.0"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "mermaid": "11.17.2",
    "test-anywhere": "^0.8.48"
  },
  "publishConfig": {
    "access": "public"
  }
}
