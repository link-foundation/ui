{
  "name": "@link-foundation/ui-components",
  "version": "0.0.0",
  "description": "Components of the associative UI framework written in Links Notation: layout elements (stack, grid, split, tab-group, dock, window, app-shell) rendered by ui-dom, with a layer manager and a dock layout saved as Links Notation",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./layout.css": "./src/layout/layout.css"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "layout",
    "split",
    "dock",
    "tabs",
    "window",
    "custom-elements"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-components"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-components#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@link-foundation/ui-core": "^0.0.0",
    "@link-foundation/ui-dom": "^0.0.0",
    "@link-foundation/ui-style": "^0.0.0",
    "@link-foundation/ui-tokens": "^0.0.0",
    "links-notation": "^0.27.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "test-anywhere": "^0.8.48"
  },
  "publishConfig": {
    "access": "public"
  }
}
