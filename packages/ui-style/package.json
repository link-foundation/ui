    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "styles",
    "css",
    "design-tokens",
    "media-queries",
    "container-queries"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-style"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-style#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@link-foundation/ui-core": "^0.0.0",
    "@link-foundation/ui-tokens": "^0.0.0"
  },
  "devDependencies": {
