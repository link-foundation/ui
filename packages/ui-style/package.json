{
  "name": "@link-foundation/ui-style",
  "version": "0.0.0",
  "description": "Style rules of the associative UI framework written in Links Notation: selectors, states, media and container conditions, resolved against ui-tokens into a CSS stylesheet or a resolved style per element",
