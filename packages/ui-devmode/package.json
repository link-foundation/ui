{
  "name": "@link-foundation/ui-devmode",
  "version": "0.0.0",
  "description": "Development/configuration mode of the associative UI framework: a runtime inspector overlay over any page rendered by ui-dom, to hover, select, inspect and edit every element, writing only to the session and user configuration layers",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./model": {
      "types": "./src/model.d.ts",
      "default": "./src/model.js"
    },
    "./agent-instruction": {
      "types": "./src/agent-instruction.d.ts",
      "default": "./src/agent-instruction.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "devtools",
    "inspector",
    "configuration"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-devmode"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-devmode#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@link-foundation/ui-config": "^0.0.0",
    "@link-foundation/ui-core": "^0.0.0",
    "@link-foundation/ui-dom": "^0.0.0",
    "@link-foundation/ui-style": "^0.0.0",
    "@link-foundation/ui-tokens": "^0.0.0"
  },
  "devDependencies": {
    "@link-foundation/ui-store": "^0.0.0",
    "jsdom": "^30.1.3",
    "test-anywhere": "^0.8.48"
  },
  "publishConfig": {
    "access": "public"
  }
}
