immortality: schema
  version 2
look: section
  label 'Look'
audio: section
  label 'Motion and sound'
palette:
  type choice
  default poseidon
  options poseidon mission
  section look
  apply
    data-attr palette
glow:
  type choice
  default medium
  options none light medium strong
  section look
  apply
    data-attr glow
cornerSize:
  type range
  default 14
  min 0
  max 32
  step 1
  unit px
  section look
  apply
    css-var --corner-size
statusBar:
  type toggle
  default true
  section look
animations:
  type toggle
  default true
  section audio
  (comfort)
sound:
  type toggle
  default true
  section audio
  (comfort)
volume:
  type range
  default 100
  min 0
  max 100
  step 1
  section audio
  (comfort)
migration
  from 1
  to 2
  old-default palette mission
  old-default glow light
  old-default statusBar false
