{
  "name": "@link-foundation/ui-store",
  "version": "0.0.0",
  "description": "Mutable links network store of the associative UI framework: stable IDs, change events, transactions, undo/redo, an operation log in Links Notation and IndexedDB persistence compatible with doublets-web",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./memory": {
      "types": "./src/memory.d.ts",
      "default": "./src/memory.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "associative",
    "store",
    "undo",
    "indexeddb",
    "doublets"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-store"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-store#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@link-foundation/ui-core": "^0.0.0"
  },
  "peerDependencies": {
    "doublets-web": "^0.1.3"
  },
  "peerDependenciesMeta": {
    "doublets-web": {
      "optional": true
    }
  },
  "devDependencies": {
    "@link-foundation/ui-links": "^0.0.0",
    "doublets-web": "^0.1.3",
    "fake-indexeddb": "^6.2.7",
    "test-anywhere": "^0.8.48"
  },
  "publishConfig": {
    "access": "public"
  }
}
