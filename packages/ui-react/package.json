{
  "name": "@link-foundation/ui-react",
  "version": "0.0.0",
  "description": "React adapter of the associative UI framework written in Links Notation: a <UiView> that mounts the ui-dom renderer, a provider, DOM-free store hooks and React components for custom dialect kinds",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./hooks": {
      "types": "./src/hooks.d.ts",
      "default": "./src/hooks.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "react",
    "adapter",
    "hooks",
    "custom-elements"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-react"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-react#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@link-foundation/ui-core": "^0.0.0",
    "@link-foundation/ui-dom": "^0.0.0",
    "@link-foundation/ui-store": "^0.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "test-anywhere": "^0.8.48"
  },
  "publishConfig": {
    "access": "public"
  }
}
