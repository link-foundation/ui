{
  "color": {
    "neutral": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1098,
          0.1059,
          0.1216
        ],
        "alpha": 1,
        "hex": "#1c1b1f"
      },
      "$description": "Text on surfaces"
    },
    "primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.4039,
          0.3137,
          0.6431
        ],
        "alpha": 1,
        "hex": "#6750a4"
      },
      "$description": "Brand colour"
    },
    "on-primary": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "action": {
      "$type": "color",
      "$value": "{color.primary}"
    },
    "scrim": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "alpha": 0.502,
        "hex": "#000000"
      }
    },
    "accent": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7,
          0.15,
          300
        ],
        "alpha": 1,
        "hex": "#ad87ed"
      }
    }
  },
  "space": {
    "small": {
      "$type": "dimension",
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "medium": {
      "$type": "dimension",
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{space.small}"
    }
  },
  "font": {
    "weight": {
      "strong": {
        "$type": "fontWeight",
        "$value": "bold"
      },
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      }
    },
    "family": {
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Roboto",
          "Noto Sans",
          "sans-serif"
        ]
      }
    }
  },
  "size": {
    "root": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    }
  },
  "motion": {
    "duration": {
      "short": {
        "$type": "duration",
        "$value": {
          "value": 150,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ]
      }
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.38
    }
  },
  "elevation": {
    "low": {
      "$type": "shadow",
      "$value": {
        "color": "{color.scrim}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 3,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "high": {
      "$type": "shadow",
      "$value": [
        "{elevation.low}",
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              0
            ],
            "alpha": 0.302,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 4,
            "unit": "px"
          },
          "blur": {
            "value": 8,
            "unit": "px"
          },
          "spread": {
            "value": 3,
            "unit": "px"
          },
          "inset": true
        }
      ]
    }
  },
  "type": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": {
          "value": 16,
          "unit": "px"
        },
        "fontWeight": "{font.weight.strong}",
        "letterSpacing": {
          "value": 0.5,
          "unit": "px"
        },
        "lineHeight": 1.5
      }
    }
  },
  "$extensions": {
    "com.github.link-foundation.ui": {
      "modes": {
        "dark": {
          "color": {
            "primary": {
              "$type": "color",
              "$value": {
                "colorSpace": "srgb",
                "components": [
                  0.8157,
                  0.7373,
                  1
                ],
                "alpha": 1,
                "hex": "#d0bcff"
              }
            },
            "on-primary": {
              "$type": "color",
              "$value": {
                "colorSpace": "srgb",
                "components": [
                  0.2196,
                  0.1176,
                  0.4471
                ],
                "alpha": 1,
                "hex": "#381e72"
              }
            },
            "action": {
              "$type": "color",
              "$value": "{color.primary}"
            },
            "surface": {
              "$type": "color",
              "$value": {
                "colorSpace": "srgb",
                "components": [
                  0.0784,
                  0.0706,
                  0.0941
                ],
                "alpha": 1,
                "hex": "#141218"
              }
            }
          }
        }
      }
    }
  }
}
