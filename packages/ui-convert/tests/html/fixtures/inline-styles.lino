(style-0: html
  (tag style)
  (raw-css '.card { padding: 8px; } .card:hover { color: #3390ec; }'))
(div-1: html
  (tag div)
  (attr class card)
  (style (padding 8px) (color '#3390ec') (background "url('https://example.com/bg.png') no-repeat") (font-family "'Fira Sans', sans-serif"))
  (style-1-0: html
    (tag style)
    (attr media print)
    (raw-css '.card { display: none; }'))
  (p-1-1: text 'Styled text'
    (tag p)
    (style (margin '0 auto') (--brand-colour '#fff')))
  (span-1-2: text 'Empty style'
    (tag span))
  (img-1-3: image
    (source /a.png)
    (alt A)
    (style (width 10px) (height 10px))))
