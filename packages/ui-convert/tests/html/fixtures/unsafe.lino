(div-0: html
  (tag div)
  (attr class widget)
  (a-0-1: html
    (tag a)
    (attr title Home)
    (text-0-1-0: text Home))
  (a-0-2: html
    (tag a)
    (text-0-2-0: text Spaced))
  (button-0-3: button
    (label Press))
  (img-0-7: image
    (source /ok.png)
    (alt 'Safe image'))
  (p-0-8: text 'Safe text'
    (tag p)))
