{
  "name": "@link-foundation/ui-convert",
  "version": "0.0.0",
  "description": "Converters between the UI dialect of Links Notation and other UI formats: HTML/DOM, JSX/TSX (MUI) and Vue SFC import, A2UI, Adaptive Cards, JSON Forms and Lottie",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./interop": "./src/interop/index.js"
  },
  "types": "./src/index.d.ts",
  "bin": {
    "ui-convert": "./src/cli.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "html",
    "dom",
    "importer",
    "jsx",
    "tsx",
    "mui",
    "vue",
    "a2ui",
    "adaptive-cards",
    "json-forms",
    "lottie"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-convert"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-convert#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/parser": "^7.29.12",
    "@link-foundation/ui-core": "^0.0.0",
    "@vue/compiler-dom": "^3.5.44",
    "links-notation": "^0.27.1",
    "parse5": "^8.0.1",
    "prettier": "^3.6.2"
  },
  "devDependencies": {
    "@link-foundation/ui-react": "^0.0.0",
    "@link-foundation/ui-tokens": "^0.0.0",
    "@link-foundation/ui-vue": "^0.0.0",
    "@lottie-animation-community/lottie-specs": "^0.3.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "ajv": "^8.17.1",
    "jsdom": "^30.1.3",
    "lottie-web": "^5.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "test-anywhere": "^0.8.48",
    "vite": "^6.4.5",
    "vue": "^3.5.44"
  },
  "publishConfig": {
    "access": "public"
  }
}
