(ui-convert-components: dialect
  (version 'ui-dialect/0'))

(common: kind
  (description 'Properties every kind accepts in documents imported from JSX and Vue components.')
  (property tag string)
  (property attr any multi)
  (property style any)
  (property raw-css string multi)
  (property unsupported any multi)
  (property on action multi)
  (property when any)
  (property each any)
  (property bind any multi))

(stack: kind
  (property style any))

(text: kind
  (property variant (enum display-large display-medium display-small headline-large headline-medium headline-small title-large title-medium title-small body-large body-medium body-small label-large label-medium label-small)))

(button: kind
  (property bind any multi))

(icon-button: kind
  (description 'A pressable control that shows an icon (MUI IconButton); the icon is its child.')
  (property label string)
  (property disabled (enum true false))
  (children any))

(text-field: kind
  (description 'A single line text input (MUI TextField).')
  (property label string)
  (property placeholder string)
  (property value string)
  (property type string)
  (property required (enum true false))
  (property disabled (enum true false))
  (children none))

(text-area: kind
  (description 'A multi line text input (MUI TextField multiline).')
  (property label string)
  (property placeholder string)
  (property value string)
  (property rows number)
  (property required (enum true false))
  (property disabled (enum true false))
  (children none))

(checkbox: kind
  (description 'A boolean input (MUI Checkbox).')
  (property label string)
  (property checked (enum true false))
  (property disabled (enum true false))
  (children none))

(switch: kind
  (description 'An on/off toggle (MUI Switch).')
  (property label string)
  (property checked (enum true false))
  (property disabled (enum true false))
  (children none))

(box: kind
  (description 'A generic container without layout of its own (MUI Box).')
  (children any))

(card: kind
  (description 'A surface that groups related content (MUI Card).')
  (property variant (enum elevated outlined))
  (children any))

(card-content: kind
  (description 'The padded content area of a card (MUI CardContent).')
  (children any))

(dialog: kind
  (description 'A modal window (MUI Dialog).')
  (property open (enum true false))
  (property title string)
  (children any))

(tabs: kind
  (description 'A set of tabs (MUI Tabs); every child is a tab.')
  (property value string)
  (children any))

(tab: kind
  (description 'One tab of tabs (MUI Tab).')
  (property label string)
  (property value string)
  (children any))

(list: kind
  (description 'A list of items (MUI List).')
  (children any))

(list-item: kind
  (description 'One item of a list (MUI ListItem).')
  (children any))

(app-bar: kind
  (description 'The top bar of a screen (MUI AppBar).')
  (property position (enum fixed absolute sticky static relative))
  (children any))

(toolbar: kind
  (description 'A row of controls (MUI Toolbar).')
  (children any))

(vue-block: kind
  (description 'A <script>, <style> or custom block of a Vue single-file component, kept as raw text: one content value per line.')
  (property content any)
  (children none))

(action: action
  (description 'Call a handler of the imported component by name; the host binds it.')
  (argument name string))
