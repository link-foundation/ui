(a2ui: mapping
  (description 'A2UI <-> ui-dialect. Component names and properties are from the basic catalog of A2UI 0.9.1.')
  (source 'https://github.com/google/A2UI/tree/main/specification/v0_9_1/json'))

(element Text text)
(element Image image)
(element Icon icon)
(element Row stack)
(element Column stack)
(element List stack)
(element Card stack)
(element Modal stack)
(element Tabs tabs)
(element Divider divider)
(element Button button)
(element TextField text-field)
(element CheckBox checkbox)
(element ChoicePicker select)
(element Slider slider)
(element DateTimeInput date-field)

(group layout Row Column List)
(group input TextField CheckBox ChoicePicker Slider DateTimeInput)

(property * weight flex)
(property layout justify justify)
(property layout align align)
(property List direction direction)
(property Icon name name)
(property Text variant variant)
(property Image description alt)
(property Image fit fit)
(property Image variant variant)
(property Divider axis axis)
(property Button variant variant)
(property input label label)
(property TextField variant variant)
(property TextField validationRegexp pattern)
(property ChoicePicker variant variant)
(property ChoicePicker displayStyle choice-style)
(property ChoicePicker filterable filterable)
(property Slider min min)
(property Slider max max)
(property DateTimeInput enableDate enable-date)
(property DateTimeInput enableTime enable-time)
(property DateTimeInput min min)
(property DateTimeInput max max)

(values justify (spaceBetween space-between) (spaceAround space-around) (spaceEvenly space-evenly))
(values variant (default outlined) (primary filled) (borderless text) (shortText short-text) (longText long-text) (multipleSelection multiple-selection) (mutuallyExclusive mutually-exclusive) (smallFeature small-feature) (mediumFeature medium-feature) (largeFeature large-feature))
(values fit (scaleDown scale-down))
