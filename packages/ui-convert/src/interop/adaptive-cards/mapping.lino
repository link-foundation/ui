adaptive-cards: mapping
  description 'Adaptive Cards <-> ui-dialect. Element versions are from the official schema 1.6.'
  source 'https://adaptivecards.io/schemas/1.6.0/adaptive-card.json'

element AdaptiveCard document
element TextBlock text
element Image image
element Container stack
element ColumnSet stack
element Column stack
element FactSet facts
element ActionSet stack since 1.2
element Input.Text text-field
element Input.Number number-field
element Input.Date date-field
element Input.Time time-field
element Input.Toggle checkbox
element Input.ChoiceSet select
element Action.Submit button
element Action.OpenUrl button
element Action.ShowCard button
element Action.ToggleVisibility button since 1.2
element Action.Execute button since 1.4

since Media 1.1
since RichTextBlock 1.2
since TextRun 1.2
since Table 1.5

group input Input.Text Input.Number Input.Date Input.Time Input.Toggle Input.ChoiceSet
group action Action.Submit Action.OpenUrl Action.ShowCard Action.ToggleVisibility Action.Execute
group container AdaptiveCard Container ColumnSet Column

property * spacing spacing
property * separator separator
property * isVisible visible since 1.2
property * height block-height since 1.1
property * horizontalAlignment alignment
property * fallback fallback since 1.2
property * requires requires since 1.2

property AdaptiveCard fallbackText fallback-text
property AdaptiveCard lang lang
property AdaptiveCard speak speak
property AdaptiveCard rtl rtl since 1.5
property AdaptiveCard metadata metadata since 1.6
property AdaptiveCard refresh refresh since 1.4
property AdaptiveCard authentication authentication since 1.4

property container style container-style since 1.2
property container bleed bleed since 1.2
property container minHeight min-height since 1.2
property container verticalContentAlignment vertical-alignment since 1.1
property container backgroundImage background-image since 1.2
property container selectAction select-action since 1.1
property Container rtl rtl since 1.5
property Column rtl rtl since 1.5
property Column width width

property TextBlock size size
property TextBlock weight weight
property TextBlock color color
property TextBlock isSubtle subtle
property TextBlock wrap wrap
property TextBlock maxLines max-lines
property TextBlock fontType font-type since 1.2
property TextBlock style text-style since 1.5

property Image altText alt
property Image size image-size
property Image style image-style
property Image width width since 1.1
property Image backgroundColor background since 1.1
property Image selectAction select-action since 1.1

property input label label since 1.3
property input isRequired required since 1.3
property input errorMessage error-message since 1.3
property input placeholder placeholder
property input value value
property input labelPosition label-position since 1.6
property input labelWidth label-width since 1.6
property input inputStyle input-style since 1.6
property Input.Text isMultiline multiline
property Input.Text maxLength max-length
property Input.Text style text-input-style
property Input.Text regex pattern since 1.3
property Input.Text inlineAction inline-action since 1.2
property Input.Number min min
property Input.Number max max
property Input.Date min min
property Input.Date max max
property Input.Time min min
property Input.Time max max
property Input.Toggle title title
property Input.Toggle valueOn value-on
property Input.Toggle valueOff value-off
property Input.Toggle wrap wrap since 1.2
property Input.ChoiceSet isMultiSelect multiple
property Input.ChoiceSet style choice-style
property Input.ChoiceSet wrap wrap since 1.2

property action title label
property action iconUrl icon since 1.1
property action style action-style since 1.2
property action tooltip tooltip since 1.5
property action isEnabled enabled since 1.5
property action mode mode since 1.5
property Action.Submit data data
property Action.Submit associatedInputs associated-inputs since 1.3
property Action.Execute verb verb
property Action.Execute data data
property Action.Execute associatedInputs associated-inputs

values size
  default normal
  extraLarge x-large
values weight
  lighter light
  default normal
  bolder bold
