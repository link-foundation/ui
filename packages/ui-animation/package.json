{
  "name": "@link-foundation/ui-animation",
  "version": "0.0.0",
  "description": "Animations of the associative UI framework written in Links Notation: a declarative model of keyframe tracks, easings, springs, timelines and state triggers, a pure seeded sampler, safety validators and a WAAPI player",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./backgrounds/starfield": {
      "types": "./src/backgrounds/starfield.d.ts",
      "default": "./src/backgrounds/starfield.js"
    },
    "./backgrounds/shader": {
      "types": "./src/backgrounds/shader.d.ts",
      "default": "./src/backgrounds/shader.js"
    },
    "./backgrounds/nebula": {
      "types": "./src/backgrounds/nebula.d.ts",
      "default": "./src/backgrounds/nebula.js"
    },
    "./backgrounds/beams": {
      "types": "./src/backgrounds/beams.d.ts",
      "default": "./src/backgrounds/beams.js"
    },
    "./backgrounds/rain": {
      "types": "./src/backgrounds/rain.d.ts",
      "default": "./src/backgrounds/rain.js"
    },
    "./backgrounds/grid": {
      "types": "./src/backgrounds/grid.d.ts",
      "default": "./src/backgrounds/grid.js"
    }
  },
  "types": "./src/index.d.ts",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ui",
    "links-notation",
    "animation",
    "waapi",
    "easing",
    "spring",
    "timeline",
    "reduced-motion"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-animation"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-animation#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@link-foundation/ui-core": "^0.0.0",
    "@link-foundation/ui-store": "^0.0.0",
    "@link-foundation/ui-themes": "^0.0.0"
  },
  "devDependencies": {
    "@link-foundation/ui-tokens": "^0.0.0",
    "esbuild": "0.27.0",
    "jsdom": "^30.1.3",
    "test-anywhere": "^0.8.48"
  },
  "publishConfig": {
    "access": "public"
  }
}
