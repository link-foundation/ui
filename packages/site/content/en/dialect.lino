page: document
  title 'The UI dialect'
  page-title: heading
    level 1
    text 'The UI dialect'
  page-lead: paragraph
    text 'LiNo describes UI as nested links: an element has an ID, a kind, properties and children. Write nested, indented links with two spaces per level.'
  section-title: heading
    level 2
    text 'One notation across platforms'
  block-0: code-block
