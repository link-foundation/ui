  event hover
    mode random
    voices quartz
  event click
    mode random
    voices cobalt relay
  event toggle
    mode random
    voices flint
  event select
    mode random
    voices comet
  event scan
    mode random
    voices ion
    throttle 120
  event open
    mode random
    voices zephyr
  event close
    mode random
    voices vapor
  event type
    mode random
    voices
  event intro
    mode random
    voices nova
  event notify
    mode random
    voices lumen
  bus
    shelf 3200 0
    compressor -18 4
    reverb 0.2
