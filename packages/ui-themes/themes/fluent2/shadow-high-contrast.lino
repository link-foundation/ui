fluent2-shadow-high-contrast: theme
  mode high-contrast
    token fluent.shadow2
      (shadow (offset-x 0) (offset-y 0) (blur 2px) (spread 0px) (color (rgb 0 0 0 0.24))) (shadow (offset-x 0) (offset-y 1px) (blur 2px) (spread 0px) (color (rgb 0 0 0 0.28)))
      fluent shadow2
      source-value '0 0 2px rgba(0,0,0,0.24), 0 1px 2px rgba(0,0,0,0.28)'
