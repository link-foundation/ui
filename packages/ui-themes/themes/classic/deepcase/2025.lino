deepcase-2025: theme
  extends base
  token chat.text '#FFFFFF'
  token chat.sidebar '#000000'
  token chat.bubble.in '#000000'
  token chat.bubble.in.text '#FFFFFF'
  token chat.bubble.out '#CCCCCC'
  token chat.bubble.out.text '#000000'
  token chat.edge '#FFFFFF'
  token color.primary '#CCCCCC'
  token color.on-primary '#000000'
  token color.surface '#000000'
  token color.on-surface '#FFFFFF'
  token color.on-surface-variant
    token color.on-surface
  token color.outline '#FFFFFF'
  token motion.duration.short 150ms
  token color.background '#000000'
  token color.surface-modal '#19202B'
  token graph.edge '#727278'
  token graph.node '#0080FF'
  token graph.label
    token color.on-surface
  token graph.value.value '#64B5F6'
  token graph.value.symbol '#FFD54F'
  token graph.value.undefined '#90A4AE'
  token graph.value.promise '#4DB6AC'
  token graph.value.boolean '#F06292'
  token graph.value.string '#81C784'
  token graph.value.number '#7986CB'
  token graph.value.bigint '#9575CD'
  token graph.value.set '#4DD0E1'
  mode dark
    token chat.text '#FFFFFF'
    token chat.sidebar '#000000'
    token chat.bubble.in '#000000'
    token chat.bubble.in.text '#FFFFFF'
    token chat.bubble.out '#CCCCCC'
    token chat.bubble.out.text '#000000'
    token chat.edge '#FFFFFF'
    token color.primary '#CCCCCC'
    token color.on-primary '#000000'
    token color.surface '#000000'
    token color.on-surface '#FFFFFF'
    token color.on-surface-variant
      token color.on-surface
    token color.outline '#FFFFFF'
    token motion.duration.short 150ms
    token color.background '#000000'
    token color.surface-modal '#19202B'
    token graph.edge '#727278'
    token graph.node '#0080FF'
    token graph.label
      token color.on-surface
    token graph.value.value '#64B5F6'
    token graph.value.symbol '#FFD54F'
    token graph.value.undefined '#90A4AE'
    token graph.value.promise '#4DB6AC'
    token graph.value.boolean '#F06292'
    token graph.value.string '#81C784'
    token graph.value.number '#7986CB'
    token graph.value.bigint '#9575CD'
    token graph.value.set '#4DD0E1'
  mode high-contrast
    token chat.text '#000000'
    token chat.sidebar '#FFFFFF'
    token chat.bubble.in '#FFFFFF'
    token chat.bubble.in.text '#000000'
    token chat.bubble.out '#000000'
    token chat.bubble.out.text '#FFFFFF'
    token chat.edge '#000000'
    token color.primary '#000000'
    token color.on-primary '#FFFFFF'
    token color.surface '#FFFFFF'
    token color.on-surface '#000000'
    token color.on-surface-variant
      token color.on-surface
    token color.outline '#000000'
    token motion.duration.short 150ms
  motion reduced
    token motion.duration.short 0ms
    token effect.glow 0
    token effect.scanline 0
    token effect.flicker 0
  style
    selector
      type graph-canvas
    background
      token color.background
  style
    selector
      type link-edge
    stroke
      token graph.edge
    arrow triangle
  style
    selector
      type link-node
    background
      token graph.node
    color
      token graph.label
  style
    selector
      type link-node
      value-type value
    background
      token graph.value.value
  style
    selector
      type link-node
      value-type symbol
    background
      token graph.value.symbol
  style
    selector
      type link-node
      value-type undefined
    background
      token graph.value.undefined
  style
    selector
      type link-node
      value-type promise
    background
      token graph.value.promise
  style
    selector
      type link-node
      value-type boolean
    background
      token graph.value.boolean
  style
    selector
      type link-node
      value-type string
    background
      token graph.value.string
  style
    selector
      type link-node
      value-type number
    background
      token graph.value.number
  style
    selector
      type link-node
      value-type bigint
    background
      token graph.value.bigint
  style
    selector
      type link-node
      value-type set
    background
      token graph.value.set
