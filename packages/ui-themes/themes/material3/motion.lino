material3-motion: theme
  source 'https://m3.material.io/styles/motion/easing-and-duration/tokens-specs'
  source 'https://github.com/material-components/material-components-android/blob/master/docs/theming/Motion.md'
  token motion.duration.short1 50ms
    m3 md.sys.motion.duration.short1
  token motion.duration.short2 100ms
    m3 md.sys.motion.duration.short2
  token motion.duration.short3 150ms
    m3 md.sys.motion.duration.short3
  token motion.duration.short4 200ms
    m3 md.sys.motion.duration.short4
  token motion.duration.medium1 250ms
    m3 md.sys.motion.duration.medium1
  token motion.duration.medium2 300ms
    m3 md.sys.motion.duration.medium2
  token motion.duration.medium3 350ms
    m3 md.sys.motion.duration.medium3
  token motion.duration.medium4 400ms
    m3 md.sys.motion.duration.medium4
  token motion.duration.long1 450ms
    m3 md.sys.motion.duration.long1
  token motion.duration.long2 500ms
    m3 md.sys.motion.duration.long2
  token motion.duration.long3 550ms
    m3 md.sys.motion.duration.long3
  token motion.duration.long4 600ms
    m3 md.sys.motion.duration.long4
  token motion.duration.extra-long1 700ms
    m3 md.sys.motion.duration.extra-long1
  token motion.duration.extra-long2 800ms
    m3 md.sys.motion.duration.extra-long2
  token motion.duration.extra-long3 900ms
    m3 md.sys.motion.duration.extra-long3
  token motion.duration.extra-long4 1000ms
    m3 md.sys.motion.duration.extra-long4
  token motion.easing.standard
    cubic-bezier 0.2 0 0 1
    m3 md.sys.motion.easing.standard
  token motion.easing.standard-accelerate
    cubic-bezier 0.3 0 1 1
    m3 md.sys.motion.easing.standard-accelerate
  token motion.easing.standard-decelerate
    cubic-bezier 0 0 0 1
    m3 md.sys.motion.easing.standard-decelerate
  token motion.easing.emphasized-accelerate
    cubic-bezier 0.3 0 0.8 0.15
    m3 md.sys.motion.easing.emphasized-accelerate
  token motion.easing.emphasized-decelerate
    cubic-bezier 0.05 0.7 0.1 1
    m3 md.sys.motion.easing.emphasized-decelerate
  token motion.easing.emphasized.join-x 0.166666
    m3 md.sys.motion.easing.emphasized
  token motion.easing.emphasized.join-y 0.4
    m3 md.sys.motion.easing.emphasized
  token motion.easing.emphasized.first
    cubic-bezier 0.3000012000048 0 0.8000012000048 0.15
    m3 md.sys.motion.easing.emphasized
  token motion.easing.emphasized.second
    cubic-bezier 0.050000359999711974 0.7 0.10000071999942399 1
    m3 md.sys.motion.easing.emphasized
  token motion.duration.short
    token motion.duration.short2
  token motion.duration.medium
    token motion.duration.medium2
  token motion.duration.long
    token motion.duration.long2
  token opacity.hover 0.08
    m3 md.sys.state.hover.state-layer-opacity
  token opacity.focus 0.12
    m3 md.sys.state.focus.state-layer-opacity
  token opacity.pressed 0.12
    m3 md.sys.state.pressed.state-layer-opacity
  token opacity.dragged 0.16
    m3 md.sys.state.dragged.state-layer-opacity
  token opacity.disabled 0.38
    m3 md.sys.state.disabled.content-opacity
  token focus.ring.width 3px
  token focus.ring.color
    token color.primary
  motion reduced
    token motion.duration.short1 0ms
    token motion.duration.short2 0ms
    token motion.duration.short3 0ms
    token motion.duration.short4 0ms
    token motion.duration.medium1 0ms
    token motion.duration.medium2 0ms
    token motion.duration.medium3 0ms
    token motion.duration.medium4 0ms
    token motion.duration.long1 0ms
    token motion.duration.long2 0ms
    token motion.duration.long3 0ms
    token motion.duration.long4 0ms
    token motion.duration.extra-long1 0ms
    token motion.duration.extra-long2 0ms
    token motion.duration.extra-long3 0ms
    token motion.duration.extra-long4 0ms
    token motion.duration.short 0ms
    token motion.duration.medium 0ms
    token motion.duration.long 0ms
