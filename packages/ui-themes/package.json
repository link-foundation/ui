{
  "name": "@link-foundation/ui-themes",
  "version": "0.0.0",
  "description": "Links Notation theme packages for the associative UI framework",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./themes/*": "./themes/*",
    "./classic/frames": {
      "types": "./src/classic/frames.d.ts",
      "default": "./src/classic/frames.js"
    }
  },
  "files": [
    "src/",
    "themes/",
    "README.md",
    "LICENSE"
  ],
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/link-foundation/ui.git",
    "directory": "packages/ui-themes"
  },
  "homepage": "https://github.com/link-foundation/ui/tree/main/packages/ui-themes#readme",
  "bugs": {
    "url": "https://github.com/link-foundation/ui/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@link-foundation/ui-tokens": "^0.0.0",
    "@material/material-color-utilities": "0.3.0",
    "@link-foundation/ui-core": "^0.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "links-notation": "^0.27.1",
    "prettier": "^3.6.2"
  }
}
