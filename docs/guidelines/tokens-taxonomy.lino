ref: token-layer
  order 1
  prefix ref
  example ref.color.blue.40
  role 'raw palette and scales; never used by components directly'
system: token-layer
  order 2
  prefix '—'
  example color.primary
  role 'semantic meaning; what themes remap'
component: token-layer
  order 3
  prefix 'component kind'
  example button.container.color
  role 'per-component slots that point at system tokens'
color: token-category
  pattern 'color.X and color.on-X'
  dtcg-type color
space: token-category
  pattern 'space.SIZE'
  dtcg-type dimension
size: token-category
  pattern 'size.PURPOSE.SIZE'
  dtcg-type dimension
shape: token-category
  pattern 'shape.corner.SIZE'
  dtcg-type dimension
type: token-category
  pattern 'type.ROLE.SIZE.PROPERTY'
  dtcg-type typography
elevation: token-category
  pattern 'elevation.levelN'
  dtcg-type shadow
motion: token-category
  pattern 'motion.duration.SPEED and motion.easing.NAME'
  dtcg-type 'duration or cubicBezier'
opacity: token-category
  pattern 'opacity.STATE'
  dtcg-type number
z: token-category
  pattern 'z.LAYER'
  dtcg-type number
breakpoint: token-category
  pattern 'breakpoint.CLASS'
  dtcg-type dimension
focus: token-category
  pattern 'focus.ring.PROPERTY'
  dtcg-type 'color or dimension'
color.primary: token-entry
  layer system
  category color
  dtcg-type color
  material3 'md.sys.color.primary'
  fluent 'colorBrandBackground'
  hig 'tint (accent) colour'
color.on-primary: token-entry
  layer system
  category color
  dtcg-type color
  material3 'md.sys.color.on-primary'
  fluent 'colorNeutralForegroundOnBrand'
  hig 'label colour on a tinted fill'
