+            attempt < 50 && isProcessAlive(identity);
+            attempt++
+          ) {
+            await new Promise((done) => setTimeout(done, 100));
+          }
+          expect(isProcessAlive(identity)).toBe(false);
+        }
+        rmSync(dir, { recursive: true, force: true });
+      }
+    }
+  );
